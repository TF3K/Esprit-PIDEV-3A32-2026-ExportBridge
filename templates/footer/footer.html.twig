<div href="#" style="height: 30px;" class="aa"><i class="fab fa-facebook-f"></i></div>
<div href="#"style="height: 30px;" class="aa"><i class="fab fa-twitter"></i></div>
<div href="#"style="height: 30px;" class="aa"><i class="fab fa-youtube"></i></div>
<div href="#"style="height: 30px;" class="aa"><i class="fab fa-instagram"></i></div>

        </div>
        </div>    
<div class="col-12 col-md-6 col-lg-3">
