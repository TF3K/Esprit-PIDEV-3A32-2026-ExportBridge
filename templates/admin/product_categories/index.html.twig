{% extends 'admin/base_admin.html.twig' %}

{% block title %}Product Categories - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Product Categories</h1>
            <a href="{{ path('app_admin_product_categories_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Category
            </a>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            <input class="form-control bg-body" type="search" id="categorySearch" placeholder="Search categories...">
        </div>
        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="categoriesTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Name</th>
                            <th class="border-0">Slug</th>
                            <th class="border-0">Description</th>
                            <th class="border-0">Products</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                        <tr>
                            <td><h6 class="mb-0">{{ category.name }}</h6></td>
                            <td><code>{{ category.slug }}</code></td>
                            <td>{{ category.description }}</td>
                            <td>
                                <span class="badge text-bg-primary">
                                    {{ category.products|length }} products
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_admin_product_categories_edit', {id: category.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form action="{{ path('app_admin_product_categories_delete', {id: category.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category? Products in it will lose their category.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No categories found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.getElementById('categorySearch').addEventListener('keyup', function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('#categoriesTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
{% endblock %}