{% extends 'admin/base_admin.html.twig' %}

{% block title %}Certificates - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Certificates</h1>
            <a href="{{ path('app_admin_certificates_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Certificate
            </a>
        </div>
    </div>

    {# Stats #}
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-primary bg-opacity-10 border border-primary rounded-3">
                <h6>Total</h6>
                <h2 class="mb-0 fs-1 text-primary">{{ certificates|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-success bg-opacity-10 border border-success rounded-3">
                <h6>Active</h6>
                <h2 class="mb-0 fs-1 text-success">
                    {{ certificates|filter(c => c.status == 'active')|length }}
                </h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-warning bg-opacity-10 border border-warning rounded-3">
                <h6>Pending</h6>
                <h2 class="mb-0 fs-1 text-warning">
                    {{ certificates|filter(c => c.status == 'pending')|length }}
                </h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-danger bg-opacity-10 border border-danger rounded-3">
                <h6>Expired</h6>
                <h2 class="mb-0 fs-1 text-danger">
                    {{ certificates|filter(c => c.status == 'expired')|length }}
                </h2>
            </div>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            {# Search + Filter + Sort toolbar #}
            <div class="row g-3 mb-4">

                {# Search #}
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput"
                            class="form-control"
                            placeholder="Search...">
                    </div>
                </div>

                {# Filter #}
                <div class="col-6 col-md-3">
                    <select id="filterSelect" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="active">Active</option>
                        <option value="pending">Pending</option>
                        <option value="expired">Expired</option>
                        <option value="revoked">Revoked</option>
                    </select>
                </div>

                {# Sort #}
                <div class="col-6 col-md-2">
                    <select id="sortSelect" class="form-select">
                        <option value="number-asc">Number A→Z</option>
                        <option value="type-asc">Type A→Z</option>
                        <option value="expiry-asc">Expiry earliest</option>
                        <option value="expiry-desc">Expiry latest</option>
                    </select>
                </div>

                {# Result count #}
                <div class="col-12 col-md-2 d-flex align-items-center">
                    <small class="text-muted" id="resultCount"></small>
                </div>

        </div>
        </div>
        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="certsTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Certificate #</th>
                            <th class="border-0">Type</th>
                            <th class="border-0">Company</th>
                            <th class="border-0">Issuing Authority</th>
                            <th class="border-0">Issue Date</th>
                            <th class="border-0">Expiry Date</th>
                            <th class="border-0">Status</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cert in certificates %}
                        <tr>
                            <td><code>{{ cert.certificateNumber }}</code></td>
                            <td>{{ cert.type }}</td>
                            <td>{{ cert.company ? cert.company.companyName : '—' }}</td>
                            <td>{{ cert.issuingAuthority ?? '—' }}</td>
                            <td>{{ cert.issueDate ? cert.issueDate|date('d/m/Y') : '—' }}</td>
                            <td>{{ cert.expiryDate ? cert.expiryDate|date('d/m/Y') : '—' }}</td>
                            <td>
                                {% if cert.status == 'active' %}
                                    <span class="badge text-bg-success">Active</span>
                                {% elseif cert.status == 'pending' %}
                                    <span class="badge text-bg-warning">Pending</span>
                                {% elseif cert.status == 'expired' %}
                                    <span class="badge text-bg-danger">Expired</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ cert.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_admin_certificates_edit', {id: cert.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a href="{{ path('app_admin_certificates_show', {id: cert.id}) }}"
                                    class="btn btn-sm btn-info me-1">
                                        <i class="bi bi-eye"></i> View
                                </a>
                                <form action="{{ path('app_admin_certificates_delete', {id: cert.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this certificate?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete-cert-' ~ cert.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No certificates found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        // ── CONFIG ─────────────────────────────────────────────
        const config = {
            rowSelector:  '#certsTable tbody tr',
            searchFields: ['td:nth-child(1)', 'td:nth-child(3)'],
            filterField:  'td:nth-child(7)',
            sortFields: {
                'number-asc':  { col: 1, dir: 'asc',  type: 'text' },
                'type-asc':    { col: 2, dir: 'asc',  type: 'text' },
                'expiry-asc':  { col: 6, dir: 'asc',  type: 'text' },
                'expiry-desc': { col: 6, dir: 'desc', type: 'text' },
            }
        };
        // ───────────────────────────────────────────────────────

        const rows        = () => [...document.querySelectorAll(config.rowSelector)];
        const searchInput = document.getElementById('searchInput');
        const filterSel   = document.getElementById('filterSelect');
        const sortSel     = document.getElementById('sortSelect');
        const countEl     = document.getElementById('resultCount');

        function normalize(str) {
            return (str || '').toLowerCase().trim();
        }

        function cellText(row, selector) {
            const el = row.querySelector(selector);
            return el ? normalize(el.textContent) : '';
        }

        function apply() {
            const query  = normalize(searchInput.value);
            const filter = normalize(filterSel.value);
            const sort   = sortSel.value;

            let visible = rows().filter(row => {
                // search across configured fields
                const matchSearch = !query || config.searchFields.some(sel =>
                    cellText(row, sel).includes(query)
                );
                // filter on one column
                const matchFilter = !filter ||
                    cellText(row, config.filterField).includes(filter);

                row.style.display = (matchSearch && matchFilter) ? '' : 'none';
                return matchSearch && matchFilter;
            });

            // sort visible rows
            const { col, dir, type } = config.sortFields[sort] || {};
            if (col !== undefined) {
                const tbody = document.querySelector('#certsTable tbody');
                visible.sort((a, b) => {
                    let va = cellText(a, `td:nth-child(${col + 1})`);
                    let vb = cellText(b, `td:nth-child(${col + 1})`);
                    if (type === 'num') { va = parseFloat(va) || 0; vb = parseFloat(vb) || 0; }
                    if (va < vb) return dir === 'asc' ? -1 : 1;
                    if (va > vb) return dir === 'asc' ?  1 : -1;
                    return 0;
                }).forEach(row => tbody.appendChild(row));
            }

            countEl.textContent = `${visible.length} result${visible.length !== 1 ? 's' : ''}`;
        }

        searchInput.addEventListener('input',  apply);
        filterSel.addEventListener('change',   apply);
        sortSel.addEventListener('change',     apply);

        apply(); // run on load to set count
    })();
    </script>
{% endblock %}