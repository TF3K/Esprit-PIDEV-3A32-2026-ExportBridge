{% extends 'admin/base_admin.html.twig' %}

{% block title %}Partnership - {{ partnership.company ? partnership.company.companyName : 'N/A' }}{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">
                Partnership —
                {{ partnership.company ? partnership.company.companyName : 'No Company' }}
            </h1>
            <div class="d-flex gap-2">
                <a href="{{ path('app_admin_partnerships_edit', {id: partnership.id}) }}"
                   class="btn btn-sm btn-primary mb-0">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <a href="{{ path('app_admin_partnerships') }}"
                   class="btn btn-sm btn-secondary mb-0">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">

        {# Partnership details #}
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0">Partnership Details</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-borderless">
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Company</span>
                            <div>{{ partnership.company ? partnership.company.companyName : '—' }}</div>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Type</span>
                            <div>{{ partnership.type ?? '—' }}</div>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Status</span>
                            <div>
                                {% if partnership.status == 'active' %}
                                    <span class="badge text-bg-success">Active</span>
                                {% elseif partnership.status == 'pending' %}
                                    <span class="badge text-bg-warning">Pending</span>
                                {% elseif partnership.status == 'terminated' %}
                                    <span class="badge text-bg-danger">Terminated</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ partnership.status }}</span>
                                {% endif %}
                            </div>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Established</span>
                            <div>
                                {{ partnership.establishedDate
                                    ? partnership.establishedDate|date('d/m/Y')
                                    : '—' }}
                            </div>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Terminated</span>
                            <div>
                                {{ partnership.terminatedDate
                                    ? partnership.terminatedDate|date('d/m/Y')
                                    : '—' }}
                            </div>
                        </li>
                        {% if partnership.notes %}
                        <li class="list-group-item px-0">
                            <span class="text-muted small">Notes</span>
                            <div class="small">{{ partnership.notes }}</div>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>

        {# Collaborations panel #}
        <div class="col-lg-8">

            
            <div class="card shadow-sm mb-4">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0">APIs for this partnership</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        <form action="{{ path('app_admin_partnerships_send_status_email', {id: partnership.id}) }}" method="post">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="bi bi-envelope me-1"></i>Send status email
                            </button>
                        </form>
                        <a href="{{ path('app_admin_partnerships_pdf', {id: partnership.id}) }}" class="btn btn-outline-dark" target="_blank">
                            <i class="bi bi-filetype-pdf me-1"></i>Open PDF
                        </a>
                    </div>
                </div>
            </div>

{# Existing collaborations #}
            <div class="card shadow-sm mb-4">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-header-title mb-0">
                        Collaborations
                        <span class="badge text-bg-primary ms-2">
                            {{ partnership.collaborations|length }}
                        </span>
                    </h5>
                </div>
                <div class="card-body">
                    {% if partnership.collaborations|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Status</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for collab in partnership.collaborations %}
                                    <tr>
                                        <td>
                                            <h6 class="mb-0">{{ collab.title }}</h6>
                                            {% if collab.description %}
                                                <small class="text-muted">
                                                    {{ collab.description|slice(0, 60) }}
                                                    {% if collab.description|length > 60 %}...{% endif %}
                                                </small>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if collab.status == 'active' %}
                                                <span class="badge text-bg-success">Active</span>
                                            {% elseif collab.status == 'pending' %}
                                                <span class="badge text-bg-warning">Pending</span>
                                            {% elseif collab.status == 'completed' %}
                                                <span class="badge text-bg-info">Completed</span>
                                            {% else %}
                                                <span class="badge text-bg-secondary">{{ collab.status }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ collab.startDate ? collab.startDate|date('d/m/Y') : '—' }}</td>
                                        <td>{{ collab.endDate ? collab.endDate|date('d/m/Y') : '—' }}</td>
                                        <td>
                                            <form action="{{ path('app_admin_partnerships_collaboration_delete', {
                                                id: partnership.id,
                                                collaborationId: collab.id
                                            }) }}" method="post" class="d-inline"
                                                onsubmit="return confirm('Remove this collaboration?')">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('delete-collab-' ~ collab.id) }}">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center py-3 mb-0">No collaborations yet.</p>
                    {% endif %}
                </div>
            </div>

            {# Add collaboration form #}
            <div class="card shadow-sm">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0">Add Collaboration</h5>
                </div>
                <div class="card-body">
                    <form action="{{ path('app_admin_partnerships_collaboration_add', {id: partnership.id}) }}"
                          method="post" class="row g-3">

                        <div class="col-12">
                            <label class="form-label">Title *</label>
                            <input type="text" name="title" class="form-control" required>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Status *</label>
                            <select name="status" class="form-select" required>
                                {% for status in ['active', 'pending', 'completed', 'cancelled'] %}
                                    <option value="{{ status }}">{{ status|capitalize }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">Start Date</label>
                            <input type="date" name="start_date" class="form-control">
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">End Date</label>
                            <input type="date" name="end_date" class="form-control">
                        </div>

                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea name="description" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary mb-0">
                                <i class="bi bi-plus-lg me-1"></i>Add Collaboration
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

{% endblock %}