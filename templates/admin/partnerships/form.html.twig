{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Edit' : 'Add' }} Partnership - ExportBridge Admin{% endblock %}

{% block admin_content %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">
                {{ mode == 'edit' ? 'Edit Partnership' : 'Add New Partnership' }}
            </h1>
            <a href="{{ path('app_admin_partnerships') }}" class="btn btn-sm btn-secondary mb-0">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header border-bottom">
            <h5 class="card-header-title">Partnership Information</h5>
        </div>
        <div class="card-body">
            <form action="" method="post" class="row g-4">

                <div class="col-lg-6">
                    <label class="form-label">Company *</label>
                    <select name="company_id" class="form-select" required>
                        <option value="">— Select Company —</option>
                        {% for company in companies %}
                            <option value="{{ company.id }}"
                                {{ partnership.company and partnership.company.id == company.id ? 'selected' : '' }}>
                                {{ company.companyName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-lg-6">
                    <label class="form-label">Type</label>
                    <select name="type" class="form-select">
                        <option value="">— Select Type —</option>
                        {% for type in ['Export', 'Import', 'Distribution', 'Joint Venture', 'Strategic Alliance'] %}
                            <option value="{{ type }}"
                                {{ partnership.type == type ? 'selected' : '' }}>
                                {{ type }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-lg-6">
                    <label class="form-label">Status *</label>
                    <select name="status" class="form-select" required>
                        {% for status in ['active', 'pending', 'terminated', 'suspended'] %}
                            <option value="{{ status }}"
                                {{ partnership.status == status ? 'selected' : '' }}>
                                {{ status|capitalize }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-lg-6">
                    <label class="form-label">Established Date</label>
                    <input type="date" name="established_date" class="form-control"
                           value="{{ partnership.establishedDate
                               ? partnership.establishedDate|date('Y-m-d')
                               : '' }}">
                </div>

                <div class="col-lg-6">
                    <label class="form-label">Terminated Date</label>
                    <input type="date" name="terminated_date" class="form-control"
                           value="{{ partnership.terminatedDate
                               ? partnership.terminatedDate|date('Y-m-d')
                               : '' }}">
                </div>

                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea name="notes" class="form-control"
                              rows="3">{{ partnership.notes ?? '' }}</textarea>
                </div>

                <div class="d-sm-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-0">
                        {{ mode == 'edit' ? 'Save Changes' : 'Add Partnership' }}
                    </button>
                </div>

            </form>
        </div>
    </div>

{% endblock %}