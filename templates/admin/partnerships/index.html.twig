{% extends 'admin/base_admin.html.twig' %}

{% block title %}Partnerships - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Partnerships</h1>
            <a href="{{ path('app_admin_partnerships_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Partnership
            </a>
        </div>
    </div>

    {# Stats #}
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-primary bg-opacity-10 border border-primary rounded-3">
                <h6>Total</h6>
                <h2 class="mb-0 fs-1 text-primary">{{ partnerships|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-success bg-opacity-10 border border-success rounded-3">
                <h6>Active</h6>
                <h2 class="mb-0 fs-1 text-success">
                    {{ partnerships|filter(p => p.status == 'active')|length }}
                </h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-warning bg-opacity-10 border border-warning rounded-3">
                <h6>Pending</h6>
                <h2 class="mb-0 fs-1 text-warning">
                    {{ partnerships|filter(p => p.status == 'pending')|length }}
                </h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-danger bg-opacity-10 border border-danger rounded-3">
                <h6>Terminated</h6>
                <h2 class="mb-0 fs-1 text-danger">
                    {{ partnerships|filter(p => p.status == 'terminated')|length }}
                </h2>
            </div>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            <input class="form-control bg-body" type="search"
                   id="partnershipSearch" placeholder="Search partnerships...">
        </div>
        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="partnershipsTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Company</th>
                            <th class="border-0">Type</th>
                            <th class="border-0">Status</th>
                            <th class="border-0">Established</th>
                            <th class="border-0">Collaborations</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for partnership in partnerships %}
                        <tr>
                            <td>
                                <h6 class="mb-0">
                                    {{ partnership.company ? partnership.company.companyName : '—' }}
                                </h6>
                            </td>
                            <td>{{ partnership.type ?? '—' }}</td>
                            <td>
                                {% if partnership.status == 'active' %}
                                    <span class="badge text-bg-success">Active</span>
                                {% elseif partnership.status == 'pending' %}
                                    <span class="badge text-bg-warning">Pending</span>
                                {% elseif partnership.status == 'terminated' %}
                                    <span class="badge text-bg-danger">Terminated</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ partnership.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {{ partnership.establishedDate
                                    ? partnership.establishedDate|date('d/m/Y')
                                    : '—' }}
                            </td>
                            <td>
                                <span class="badge text-bg-info">
                                    {{ partnership.collaborations|length }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_admin_partnerships_show', {id: partnership.id}) }}"
                                   class="btn btn-sm btn-info me-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_admin_partnerships_edit', {id: partnership.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="{{ path('app_admin_partnerships_delete', {id: partnership.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this partnership?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete-partnership-' ~ partnership.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No partnerships found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.getElementById('partnershipSearch').addEventListener('keyup', function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('#partnershipsTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
{% endblock %}