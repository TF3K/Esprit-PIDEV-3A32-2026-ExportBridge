{% extends 'admin/base_admin.html.twig' %}

{% block title %}Partnerships - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Partnerships</h1>
            <a href="{{ path('app_admin_partnerships_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Partnership
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-primary bg-opacity-10 border border-primary rounded-3">
                <h6>Total</h6>
                <h2 class="mb-0 fs-1 text-primary">{{ partnerships|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-success bg-opacity-10 border border-success rounded-3">
                <h6>Active</h6>
                <h2 class="mb-0 fs-1 text-success">{{ partnerships|filter(p => p.status == 'active')|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-warning bg-opacity-10 border border-warning rounded-3">
                <h6>Pending</h6>
                <h2 class="mb-0 fs-1 text-warning">{{ partnerships|filter(p => p.status == 'pending')|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="text-center p-4 bg-danger bg-opacity-10 border border-danger rounded-3">
                <h6>Terminated</h6>
                <h2 class="mb-0 fs-1 text-danger">{{ partnerships|filter(p => p.status == 'terminated')|length }}</h2>
            </div>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            <div class="row g-3">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search partnerships...">
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select id="filterSelect" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="active">Active</option>
                        <option value="pending">Pending</option>
                        <option value="terminated">Terminated</option>
                        <option value="suspended">Suspended</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <select id="sortSelect" class="form-select">
                        <option value="company-asc">Company A-Z</option>
                        <option value="company-desc">Company Z-A</option>
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex align-items-center">
                    <small class="text-muted" id="resultCount"></small>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="partnershipsTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Company</th>
                            <th class="border-0">Type</th>
                            <th class="border-0">Status</th>
                            <th class="border-0">Established</th>
                            <th class="border-0">Collaborations</th>
                            <th class="border-0">Certificates</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for partnership in partnerships %}
                            <tr>
                                <td><h6 class="mb-0">{{ partnership.company ? partnership.company.companyName : '-' }}</h6></td>
                                <td>{{ partnership.type ?? '-' }}</td>
                                <td>
                                    {% if partnership.status == 'active' %}
                                        <span class="badge text-bg-success">Active</span>
                                    {% elseif partnership.status == 'pending' %}
                                        <span class="badge text-bg-warning">Pending</span>
                                    {% elseif partnership.status == 'terminated' %}
                                        <span class="badge text-bg-danger">Terminated</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">{{ partnership.status|capitalize }}</span>
                                    {% endif %}
                                </td>
                                <td data-sort="{{ partnership.establishedDate ? partnership.establishedDate|date('Y-m-d') : '' }}">
                                    {{ partnership.establishedDate ? partnership.establishedDate|date('d/m/Y') : '-' }}
                                </td>
                                <td><span class="badge text-bg-info">{{ partnership.collaborations|length }}</span></td>
                                <td><span class="badge text-bg-success">{{ partnership.certificates|length }}</span></td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a href="{{ path('app_admin_partnerships_show', {id: partnership.id}) }}" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a href="{{ path('app_admin_partnerships_edit', {id: partnership.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a href="{{ path('app_admin_certificates_add', {partnershipId: partnership.id}) }}" class="btn btn-sm btn-success">
                                            <i class="bi bi-plus-circle"></i> Certificate
                                        </a>
                                        <form action="{{ path('app_admin_partnerships_delete', {id: partnership.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Delete this partnership?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-partnership-' ~ partnership.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr data-empty-row="true">
                                <td colspan="7" class="text-center text-muted py-4">No partnerships found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        const config = {
            rowSelector: '#partnershipsTable tbody tr:not([data-empty-row])',
            tableBodySelector: '#partnershipsTable tbody',
            searchFields: ['td:nth-child(1)', 'td:nth-child(2)'],
            filterField: 'td:nth-child(3)',
            sortFields: {
                'company-asc': { col: 0, dir: 'asc', type: 'text' },
                'company-desc': { col: 0, dir: 'desc', type: 'text' },
                'newest': { col: 3, dir: 'desc', type: 'text' },
                'oldest': { col: 3, dir: 'asc', type: 'text' },
            }
        };

        const rows = () => [...document.querySelectorAll(config.rowSelector)];
        const searchInput = document.getElementById('searchInput');
        const filterSel = document.getElementById('filterSelect');
        const sortSel = document.getElementById('sortSelect');
        const countEl = document.getElementById('resultCount');

        function normalize(str) {
            return (str || '').toLowerCase().trim();
        }

        function cellText(row, selector) {
            const el = row.querySelector(selector);
            return el ? normalize(el.dataset.sort || el.textContent) : '';
        }

        function apply() {
            const query = normalize(searchInput.value);
            const filter = normalize(filterSel.value);
            const sort = sortSel.value;

            const visible = rows().filter(row => {
                const matchSearch = !query || config.searchFields.some(sel => cellText(row, sel).includes(query));
                const matchFilter = !filter || cellText(row, config.filterField).includes(filter);
                row.style.display = (matchSearch && matchFilter) ? '' : 'none';
                return matchSearch && matchFilter;
            });

            const { col, dir, type } = config.sortFields[sort] || {};
            if (col !== undefined) {
                const tbody = document.querySelector(config.tableBodySelector);
                visible.sort((a, b) => {
                    let va = cellText(a, `td:nth-child(${col + 1})`);
                    let vb = cellText(b, `td:nth-child(${col + 1})`);
                    if (type === 'num') {
                        va = parseFloat(va) || 0;
                        vb = parseFloat(vb) || 0;
                    }
                    if (va < vb) return dir === 'asc' ? -1 : 1;
                    if (va > vb) return dir === 'asc' ? 1 : -1;
                    return 0;
                }).forEach(row => tbody.appendChild(row));
            }

            countEl.textContent = `${visible.length} result${visible.length !== 1 ? 's' : ''}`;
        }

        searchInput.addEventListener('input', apply);
        filterSel.addEventListener('change', apply);
        sortSel.addEventListener('change', apply);
        apply();
    })();
    </script>
{% endblock %}
