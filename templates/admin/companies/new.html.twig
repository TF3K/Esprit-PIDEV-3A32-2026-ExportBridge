{% extends 'admin/base_admin.html.twig' %}
{% block title %}Company - Admin{% endblock %}

{% block body %}

<section style="    position: relative;
    left: 249px;
    background-color: #f7f7f7;
    padding: 20px;
    width: 82%;">
    <div class="container">

        <div class="card-body border rounded-3 mb-5" style="padding: 1rem 16px;">
            <div class="bs-stepper-content">

                <form action="{{ path('app_company_new') }}" method="POST">

                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="bi {{ label == 'error' ? 'bi-exclamation-octagon-fill' : 'bi-check-circle-fill' }} me-2"></i>
                                    {{ message }}
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    <div id="step-1" role="tabpanel" class="content fade" style="opacity:1">
                        <h4>Add company</h4>
                        <hr>

                        <div class="row g-4">

                            <!-- Company Name -->
                            <div class="col-12">
                                <label class="form-label">Company name</label>
                                <input class="form-control"
                                       type="text"
                                       name="company_name"
                                       placeholder="Enter company name"
                                       required>
                            </div>

                            <!-- Market -->
                            <div class="col-md-6">
                                <label class="form-label">Market</label>
                                <select class="form-select js-choice" name="market_name" required>
                                    <option value="">Select market</option>
                                    {% for market in markets %}
                                        <option value="{{ market.name }}">{{ market.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <!-- Domain -->
                            <div class="col-md-6">
                                <label class="form-label">Domain</label>
                                <input class="form-control"
                                       type="text"
                                       name="domain"
                                       placeholder="Enter domain">
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input class="form-control"
                                       type="email"
                                       name="email"
                                       placeholder="Enter email"
                                       required>
                            </div>

                            <!-- Country -->
                            <div class="col-md-6">
                                <label class="form-label">Country</label>
                                <input class="form-control"
                                       type="text"
                                       name="country"
                                       placeholder="Enter country"
                                       required>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label class="form-label">Address</label>
                                <textarea class="form-control"
                                          rows="2"
                                          name="address"
                                          placeholder="Enter address"
                                          required></textarea>
                            </div>

                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary mb-0">
                                Submit
                            </button>
                        </div>

                    </div>

                </form>

            </div>
        </div>

    </div>
</section>

{% endblock %}