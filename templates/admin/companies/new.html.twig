{% extends 'admin/base_admin.html.twig' %}
{% block title %}Add Company - ExportBridge Admin{% endblock %}

{% block admin_content %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Add Company</h1>
            <a href="{{ path('app_admin_companies') }}" class="btn btn-sm btn-secondary mb-0">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi {{ label == 'error' ? 'bi-exclamation-octagon-fill' : 'bi-check-circle-fill' }} me-2"></i>
                    {{ message }}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow">
        <div class="card-header border-bottom">
            <h5 class="card-header-title mb-0">Company Information</h5>
        </div>
        <div class="card-body">
            <form action="{{ path('app_company_new') }}" method="POST" class="row g-4">

                <div class="col-12">
                    <label class="form-label">Company name</label>
                    <input class="form-control"
                           type="text"
                           name="company_name"
                           placeholder="Enter company name"
                           required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Market</label>
                    <select class="form-select js-choice" name="market_name" required>
                        <option value="">Select market</option>
                        {% for market in markets %}
                            <option value="{{ market.name }}">{{ market.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Domain</label>
                    <input class="form-control"
                           type="text"
                           name="domain"
                           placeholder="Enter domain">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input class="form-control"
                           type="email"
                           name="email"
                           placeholder="Enter email"
                           required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Country</label>
                    <input class="form-control"
                           type="text"
                           name="country"
                           placeholder="Enter country"
                           required>
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea class="form-control"
                              rows="3"
                              name="address"
                              placeholder="Enter address"
                              required></textarea>
                </div>

                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-0">
                        Submit
                    </button>
                </div>

            </form>
        </div>
    </div>

{% endblock %}