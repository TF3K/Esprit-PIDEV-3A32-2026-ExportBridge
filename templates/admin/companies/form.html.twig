{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ mode == 'edit' ? 'Edit' : 'Add' }} Company - ExportBridge Admin{% endblock %}

{% block admin_content %}
    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">
                {{ mode == 'edit' ? 'Edit Company' : 'Add New Company' }}
            </h1>
            <a href="{{ path('app_admin_companies') }}" class="btn btn-sm btn-secondary mb-0">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header border-bottom">
            <h5 class="card-header-title">Company Information</h5>
        </div>
        <div class="card-body">
            <form action="" method="post" class="row g-4">

                {# Company Name #}
                <div class="col-lg-6">
                    <label class="form-label">Company Name *</label>
                    <input type="text" name="company_name"
                           class="form-control {{ errors.company_name is defined ? 'is-invalid' : '' }}"
                           value="{{ old.companyName ?? company.companyName ?? '' }}" required>
                    {% if errors.company_name is defined %}
                        <div class="invalid-feedback">{{ errors.company_name }}</div>
                    {% endif %}
                </div>

                {# Domain #}
                <div class="col-lg-6">
                    <label class="form-label">Domain</label>
                    <input type="text" name="domain"
                           class="form-control {{ errors.domain is defined ? 'is-invalid' : '' }}"
                           placeholder="e.g. manufacturing"
                           value="{{ old.domain ?? company.domain ?? '' }}">
                    {% if errors.domain is defined %}
                        <div class="invalid-feedback">{{ errors.domain }}</div>
                    {% endif %}
                </div>

                {# Tax Number #}
                <div class="col-lg-6">
                    <label class="form-label">Tax Number</label>
                    <input type="text" name="tax_number"
                           class="form-control {{ errors.tax_number is defined ? 'is-invalid' : '' }}"
                           value="{{ old.taxNumber ?? company.taxNumber ?? '' }}">
                    {% if errors.tax_number is defined %}
                        <div class="invalid-feedback">{{ errors.tax_number }}</div>
                    {% endif %}
                </div>

                {# Registration Number #}
                <div class="col-lg-6">
                    <label class="form-label">Registration Number</label>
                    <input type="text" name="registration_number"
                           class="form-control {{ errors.registration_number is defined ? 'is-invalid' : '' }}"
                           value="{{ old.registrationNumber ?? company.registrationNumber ?? '' }}">
                    {% if errors.registration_number is defined %}
                        <div class="invalid-feedback">{{ errors.registration_number }}</div>
                    {% endif %}
                </div>

                {# Country #}
                <div class="col-lg-6">
                    <label class="form-label">Country</label>
                    <input type="text" name="country"
                           class="form-control {{ errors.country is defined ? 'is-invalid' : '' }}"
                           value="{{ old.country ?? company.country ?? '' }}">
                    {% if errors.country is defined %}
                        <div class="invalid-feedback">{{ errors.country }}</div>
                    {% endif %}
                </div>

                {# Contact Email #}
                <div class="col-lg-6">
                    <label class="form-label">Contact Email</label>
                    <input type="email" name="contact_email"
                           class="form-control {{ errors.contact_email is defined ? 'is-invalid' : '' }}"
                           value="{{ old.contactEmail ?? company.contactEmail ?? '' }}">
                    {% if errors.contact_email is defined %}
                        <div class="invalid-feedback">{{ errors.contact_email }}</div>
                    {% endif %}
                </div>

                {# Contact Phone #}
                <div class="col-lg-6">
                    <label class="form-label">Contact Phone</label>
                    <input type="text" name="contact_phone"
                           class="form-control {{ errors.contact_phone is defined ? 'is-invalid' : '' }}"
                           value="{{ old.contactPhone ?? company.contactPhone ?? '' }}">
                    {% if errors.contact_phone is defined %}
                        <div class="invalid-feedback">{{ errors.contact_phone }}</div>
                    {% endif %}
                </div>

                {# Rating #}
                <div class="col-lg-6">
                    <label class="form-label">Rating (1–5)</label>
                    <input type="number" name="rating" min="1" max="5"
                           class="form-control {{ errors.rating is defined ? 'is-invalid' : '' }}"
                           value="{{ old.rating ?? company.rating ?? '' }}">
                    {% if errors.rating is defined %}
                        <div class="invalid-feedback">{{ errors.rating }}</div>
                    {% endif %}
                </div>

                {# Address #}
                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea name="address" class="form-control" rows="3">{{ old.address ?? company.address ?? '' }}</textarea>
                </div>

                {# Banned toggle — edit only #}
                {% if mode == 'edit' %}
                <div class="col-12">
                    <div class="form-check form-switch form-check-lg">
                        <input class="form-check-input" type="checkbox"
                               name="is_banned" id="isBanned"
                               {{ company.isBanned ? 'checked' : '' }}>
                        <label class="form-check-label" for="isBanned">Banned</label>
                    </div>
                </div>
                {% endif %}

                {# Submit #}
                <div class="d-sm-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-0">
                        {{ mode == 'edit' ? 'Save Changes' : 'Add Company' }}
                    </button>
                </div>

            </form>
        </div>
    </div>
{% endblock %}