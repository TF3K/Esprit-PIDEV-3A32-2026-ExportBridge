{# templates/admin/managers/index.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Managers - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {# ================= FLASH MESSAGES ================= #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# ================= PAGE HEADER ================= #}
    <div class="row mb-4">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-3 mb-sm-0">Managers</h1>

            <a href="{{ path('app_admin_managers_add') }}"
               class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>
                Add Manager
            </a>
        </div>
    </div>

    {# ================= CARD ================= #}
    <div class="card border-0 shadow-sm rounded-4">

        {# FILTER BAR #}
        <div class="card-header bg-white border-0 pb-0">
            <div class="row g-3">

                {# Search #}
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="searchInput"
                               class="form-control border-0 bg-light"
                               placeholder="Search name, email, company...">
                    </div>
                </div>

                {# Role Filter #}
                <div class="col-md-3">
                    <select id="filterSelect" class="form-select">
                        <option value="">All Roles</option>
                        <option value="admin">Admin</option>
                        <option value="user">User</option>
                    </select>
                </div>

                {# Sort #}
                <div class="col-md-3">
                    <select id="sortSelect" class="form-select">
                        <option value="name-asc">Name A → Z</option>
                        <option value="name-desc">Name Z → A</option>
                        <option value="email-asc">Email A → Z</option>
                        <option value="newest">Newest First</option>
                        <option value="oldest">Oldest First</option>
                    </select>
                </div>

                {# Counter #}
                <div class="col-md-1 d-flex align-items-center">
                    <small class="text-muted" id="resultCount"></small>
                </div>

            </div>
        </div>

        {# TABLE #}
        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle table-hover" id="managersTable">

                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Company</th>
                            <th>Role</th>
                            <th>Created At</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for manager in managers %}
                        <tr>

                            <td>
                                <strong>
                                    {{ manager.firstName }} {{ manager.lastName }}
                                </strong>
                            </td>

                            <td>{{ manager.email }}</td>

                            <td>
                                {{ manager.company ? manager.company.companyName : '—' }}
                            </td>

                            <td class="role-cell">
                                {% if 'ROLE_ADMIN' in manager.roles %}
                                    <span class="badge bg-danger">Admin</span>
                                {% else %}
                                    <span class="badge bg-secondary">User</span>
                                {% endif %}
                            </td>

                            <td data-date="{{ manager.createdAt ? manager.createdAt|date('Y-m-d') : '' }}">
                                {{ manager.createdAt ? manager.createdAt|date('d/m/Y') : '—' }}
                            </td>

                            <td class="text-end">

                                <a href="{{ path('app_admin_managers_edit', {id: manager.id}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                {% if app.user and manager.id != app.user.id %}
                                    <form method="post"
                                          action="{{ path('app_admin_managers_delete', {id: manager.id}) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this manager ?')">

                                        <input type="hidden"
                                               name="_token"
                                               value="{{ csrf_token('delete-manager-' ~ manager.id) }}">

                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </form>
                                {% else %}
                                    <span class="text-muted small ms-2">Current user</span>
                                {% endif %}

                            </td>

                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No managers found.
                            </td>
                        </tr>
                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>
    </div>

{% endblock %}

{% block javascripts %}
{{ parent() }}

<script>
document.addEventListener('DOMContentLoaded', function () {

    const table       = document.getElementById('managersTable');
    const searchInput = document.getElementById('searchInput');
    const filterSel   = document.getElementById('filterSelect');
    const sortSel     = document.getElementById('sortSelect');
    const countEl     = document.getElementById('resultCount');

    if (!table) return;

    const tbody = table.querySelector('tbody');

    function rows() {
        return Array.from(tbody.querySelectorAll('tr'))
            .filter(row => row.children.length > 1);
    }

    function text(el) {
        return el.textContent.toLowerCase().trim();
    }

    function applyFilters() {

        let data = rows();

        const search = searchInput.value.toLowerCase().trim();
        const role   = filterSel.value;
        const sort   = sortSel.value;

        data.forEach(row => {

            const fullText = text(row);
            const roleText = text(row.querySelector('.role-cell'));

            let visible = true;

            if (search && !fullText.includes(search)) {
                visible = false;
            }

            if (role && !roleText.includes(role)) {
                visible = false;
            }

            row.style.display = visible ? '' : 'none';
        });

        let visibleRows = data.filter(row => row.style.display !== 'none');

        visibleRows.sort((a, b) => {

            const nameA  = text(a.children[0]);
            const nameB  = text(b.children[0]);

            const emailA = text(a.children[1]);
            const emailB = text(b.children[1]);

            const dateA  = a.children[4].dataset.date;
            const dateB  = b.children[4].dataset.date;

            switch (sort) {
                case 'name-desc': return nameB.localeCompare(nameA);
                case 'email-asc': return emailA.localeCompare(emailB);
                case 'newest':    return dateB.localeCompare(dateA);
                case 'oldest':    return dateA.localeCompare(dateB);
                default:          return nameA.localeCompare(nameB);
            }

        });

        visibleRows.forEach(row => tbody.appendChild(row));

        countEl.textContent = visibleRows.length;
    }

    searchInput.addEventListener('input', applyFilters);
    filterSel.addEventListener('change', applyFilters);
    sortSel.addEventListener('change', applyFilters);

    applyFilters();
});
</script>

{% endblock %}