{% extends 'base.html.twig' %}


{% block body %}
<div class="container" style="margin-top: 50px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-8" data-aos="fade-up" data-aos-duration="1000">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h2 class="mb-0">Assistant Sikipon AI</h2>
                    <p class="mb-0 small text-uppercase tracking-wider">Spécialiste Import/Export & Programmation</p>
                </div>
                <div class="card-body p-5">
                    <p class="text-muted mb-4">
                        Posez votre question. Sikipon analysera nos services ExportBridge et vous répondra instantanément par email.
                    </p>

                    <div id="alert-status" class="alert d-none"></div>

                    <form id="chatbot-form">
                        <div class="mb-3">
                            <label for="email" class="form-label">Votre adresse Email</label>
                            <input type="email" id="email" class="form-control" placeholder="nom@exemple.com" required>
                        </div>
                        <div class="mb-4">
                            <label for="question" class="form-label">Votre Question</label>
                            <textarea id="question" class="form-control" rows="4" placeholder="Ex: Quels sont les tarifs pour un transport vers la France ?" required></textarea>
                        </div>
                        <button type="submit" id="btn-submit" class="btn btn-dark w-100 py-3">
                            <span id="btn-text">Interroger Sikipon</span>
                            <span id="btn-loader" class="spinner-border spinner-border-sm d-none"></span>
                        </button>
                    </form>

                    <div id="response-container" class="mt-4 d-none p-3 bg-light border-start border-4 border-dark">
                        <h5>Réponse de Sikipon :</h5>
                        <div id="bot-answer" class="text-secondary"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

</script>
{% endblock %}