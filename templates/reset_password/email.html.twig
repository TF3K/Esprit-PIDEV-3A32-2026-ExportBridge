<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f4f4f4; padding: 40px;">
    <div style="max-width: 520px; margin: 0 auto; background: #fff; border-radius: 8px; padding: 40px;">

        <h2 style="color: #0d6efd; margin-bottom: 8px;">ExportBridge</h2>
        <hr style="margin-bottom: 24px;">

        <h3 style="margin-bottom: 8px;">Reset your password</h3>
        <p style="color: #555;">Hi! We received a request to reset your password. Click the button below to proceed.</p>

        <div style="text-align: center; margin: 32px 0;">
            <a href="{{ 'http://127.0.0.1:8000' ~ path('app_reset_password', {token: resetToken.token}) }}"
               style="background: #0d6efd; color: #fff; padding: 12px 32px; border-radius: 6px; text-decoration: none; font-weight: bold;">
                Reset my password
            </a>
        </div>

        <p style="color: #888; font-size: 13px;">
            This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            If you did not request a password reset, you can safely ignore this email.
        </p>

        <hr style="margin-top: 24px;">
        <p style="color: #aaa; font-size: 12px; text-align: center;">ExportBridge &mdash; EU Export Documentation</p>

    </div>
</body>
</html>