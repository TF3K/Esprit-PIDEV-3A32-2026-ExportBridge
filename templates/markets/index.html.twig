{% extends 'admin/base_admin.html.twig' %}

{% block title %}Markets - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Markets</h1>
            <a href="{{ path('app_admin_markets_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Market
            </a>
        </div>
    </div>

    {# Stats #}
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-primary bg-opacity-10 border border-primary rounded-3">
                <h6>Total Markets</h6>
                <h2 class="mb-0 fs-1 text-primary">{{ markets|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-success bg-opacity-10 border border-success rounded-3">
                <h6>EU Markets</h6>
                <h2 class="mb-0 fs-1 text-success">
                    {{ markets|filter(m => m.isEu)|length }}
                </h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-info bg-opacity-10 border border-info rounded-3">
                <h6>Non-EU Markets</h6>
                <h2 class="mb-0 fs-1 text-info">
                    {{ markets|filter(m => not m.isEu)|length }}
                </h2>
            </div>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            <input class="form-control bg-body" type="search"
                   id="marketSearch" placeholder="Search markets...">
        </div>
        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="marketsTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Country</th>
                            <th class="border-0">Code</th>
                            <th class="border-0">Region</th>
                            <th class="border-0">Trade Agreement</th>
                            <th class="border-0">EU</th>
                            <th class="border-0">Requirements</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for market in markets %}
                        <tr>
                            <td><h6 class="mb-0">{{ market.name }}</h6></td>
                            <td><code>{{ market.countryCode }}</code></td>
                            <td>{{ market.region ?? '—' }}</td>
                            <td>{{ market.tradeAgreement ?? '—' }}</td>
                            <td>
                                {% if market.isEu %}
                                    <span class="badge text-bg-success">EU</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Non-EU</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge text-bg-primary">
                                    {{ market.certificateRequirements|length }} requirements
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_admin_markets_edit', {id: market.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form action="{{ path('app_admin_markets_delete', {id: market.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this market?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete-market-' ~ market.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No markets found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.getElementById('marketSearch').addEventListener('keyup', function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('#marketsTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
{% endblock %}