{% extends 'user/base_user.html.twig' %}
{% block title %}Courses - Admin{% endblock %}

{% block body %}
<div class="container" style="    position: relative;
    left: 249px;
    background-color: #f7f7f7;
    padding: 20px;
    width: 82%; margin: 0;">
    <div class="row">
        <div class="col-xl-9 border rounded-3 mb-5">
            <div class="card-header bg-transparent border-bottom" style="padding:16px">
                <h3 class="mb-0">My Courses List</h3>
            </div>
            
            <div class="card-body" style="padding: 16px;">
                <div class="row g-3 align-items-center justify-content-between mb-4">
                    <div class="col-md-8">
                        <form class="rounded position-relative" action="{{ path('search') }}">
                            <input class="form-control pe-5 bg-transparent" name="name" type="search" placeholder="Search" aria-label="Search" value="{{ app.request.query.get('name') }}">
                            <button class="bg-transparent p-2 position-absolute top-50 end-0 translate-middle-y border-0 text-primary-hover text-reset" type="submit">
                                <i class="fas fa-search fs-6"></i>
                            </button>
                        </form>
                    </div>
                    <div class="col-md-3">
                   <form method="GET" action="{{ path('search') }}">
    <select name="sort" class="form-select js-choice bg-transparent" onchange="this.form.submit()">
        <option value="">Sort by</option>
        <option value="name" {% if app.request.query.get('sort') == 'name' %}selected{% endif %}>Name (A-Z)</option>
        <option value="region" {% if app.request.query.get('sort') == 'region' %}selected{% endif %}>Region</option>
        <option value="is_eu" {% if app.request.query.get('sort') == 'is_eu' %}selected{% endif %}>EU Priority</option>
    </select>
                    </div>
                </div>

        <div class="table-responsive border-0">
    {# Étape 1 : On vérifie si la liste est vide #}
    {% if markets is empty %}
        
        {# Message affiché si aucun résultat n'est trouvé #}
        <div class="text-center p-5 border rounded-3 bg-light">
            <i class="fas fa-exclamation-circle fa-3x text-secondary mb-3"></i>
            <p class="h5 text-secondary">Aucun market ne correspond à votre recherche "{{ app.request.query.get('name') }}".</p>
            <a href="{{ path('app_market_list') }}" class="btn btn-primary-soft btn-sm mt-2">Afficher tous les markets</a>
        </div>

    {% else %}
                        <table class="table table-dark-gray align-middle p-4 mb-0 table-hover">
                            <thead>
                                <tr>
                                    <th scope="col" class="border-0 rounded-start">Course Title</th>
                                    <th scope="col" class="border-0">Region</th>
                                    <th scope="col" class="border-0">Country</th>
                                    <th scope="col" class="border-0">Featured</th>
                                    <th scope="col" class="border-0 rounded-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for m in markets %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <h6 class="mb-0 ms-2">{{ m.name }}</h6>
                                            </div>
                                        </td>
                                        <td>{{ m.region }}</td>
                                        <td>{{ m.countryCode }}</td>
                                        <td>
                                            {% if m.isEu %}
                                                <span class="badge bg-success">UE</span>
                                            {% else %}
                                                <span class="badge bg-secondary">Hors UE</span>
                                            {% endif %}
                                        </td>
          <td>
    {# Bouton de suppression #}
    <a href="{{ path('app_market_update', {id: m.id}) }}" class="btn btn-sm btn-success-soft btn-round me-1 mb-0"><i class="far fa-fw fa-edit"></i></a>
    <form method="post" action="{{ path('deleteMarket', {id: m.id}) }}" 
          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce marché ?');" 
          style="display:inline">
        
        {# Protection CSRF obligatoire pour une suppression #}
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ m.id) }}">
        
        <button class="btn btn-sm btn-danger-soft btn-round mb-0">
            <i class="fas fa-fw fa-times"></i>
        </button>
    </form>
</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
              <div class="d-sm-flex justify-content-sm-between align-items-sm-center mt-4 mt-sm-3">
    <p class="mb-0 text-center text-sm-start">
        Showing {{ from|default(0) }} to {{ to|default(0) }} of {{ totalEntries|default(0) }} entries
    </p>

    <nav class="d-flex justify-content-center mb-0" aria-label="navigation">
        <ul class="pagination pagination-sm pagination-primary-soft d-inline-block d-md-flex rounded mb-0">
            
            {# Bouton Précédent : Désactivé si on est à la page 1 #}
            <li class="page-item mb-0 {% if currentPage|default(1) == 1 %}disabled{% endif %}">
                <a class="page-link" href="{{ path('app_market_list', {page: currentPage|default(1) - 1}) }}" tabindex="-1">
                    <i class="fas fa-angle-left"></i>
                </a>
            </li>

            {# Boucle dynamique pour les numéros de page #}
            {% if totalPages|default(1) > 0 %}
                {% for i in 1..totalPages|default(1) %}
                    <li class="page-item mb-0 {% if i == currentPage|default(1) %}active{% endif %}">
                        <a class="page-link" href="{{ path('app_market_list', {page: i}) }}">{{ i }}</a>
                    </li>
                {% endfor %}
            {% endif %}

            {# Bouton Suivant : Désactivé si on est à la dernière page #}
            <li class="page-item mb-0 {% if currentPage|default(1) == totalPages|default(1) %}disabled{% endif %}">
                <a class="page-link" href="{{ path('app_market_list', {page: currentPage|default(1) + 1}) }}">
                    <i class="fas fa-angle-right"></i>
                </a>
            </li>
            
        </ul>
    </nav>
</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}