{% extends 'user/base_user.html.twig' %}

{% block title %}Courses - Admin{% endblock %}

{% block body %}







<section <section style="    position: relative;
    left: 249px;
    background-color: #f7f7f7;
    padding: 20px;
    width: 82%;">
    <div class="container">
	<div class="container">
		


<div class="card-body border rounded-3 mb-5 " style="padding: 1rem 16px;">
    <div class="bs-stepper-content">
        <form action="{{ path('app_market_create') }}" method="POST">
            
            <input type="hidden" name="_token" value="{{ csrf_token('market_create') }}">
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi {{ label == 'error' ? 'bi-exclamation-octagon-fill' : 'bi-check-circle-fill' }} me-2"></i>
                {{ message }}
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}
            <div id="step-1" role="tabpanel" class="content fade" style="opacity:1">
                <h4>Add market</h4>
                <hr>
                <div class="row g-4">
                    <div class="col-12">
                        <label class="form-label">Market title</label>
                        <input class="form-control" type="text" name="title" value="{{ app.request.request.get('title') }}" placeholder="Enter market title" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Trade agreement</label>
                        <textarea class="form-control" rows="2" name="trade_agreement" placeholder="Enter agreement" required></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Region</label>
                        <select class="form-select js-choice" name="region" data-search-enabled="true" required>
                            <option value="">Select Region</option>
                            <option value="UE">UE</option>
                            <option value="USMCA">ACEUM / USMCA</option>
                            <option value="ASEAN">RCEP & ASEAN</option>
                            <option value="AfCFTA">ZLECAF / AfCFTA</option>
                            <option value="CCG">CCG</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Country Code</label>
                        <select class="form-select js-choice" name="country_code" required>
                            <option value="">Select country_code</option>
                            <option value="FR">FR</option>
                            <option value="DE">DE</option>
                            <option value="IT">IT</option>
                            <option value="ES">ES</option>
                            <option value="US">US</option>
                            <option value="TN">TN</option>
                            <option value="MA">MA</option>
                        </select>
                    </div>

                    <div class="col-md-6 d-flex align-items-center justify-content-start mt-5">
                        <div class="form-check form-switch form-check-md">
                            <input class="form-check-input" type="checkbox" id="checkPrivacy1" name="featured" value="1">
                            <label class="form-check-label" for="checkPrivacy1">Check this for featured course</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="2" name="description" value="{{ app.request.request.get('description') }} placeholder="Enter description" required></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-primary mb-0">Submit</button>
                </div>
            </div>
        </form>
    </div>
</div>


			{% endblock %}