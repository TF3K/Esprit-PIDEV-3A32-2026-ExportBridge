{% extends 'base.html.twig' %}

{% block body %}

<style>
   :root {
    --chat-bg: #ffffff;
    --chat-surface: #f7f7f7;
    --chat-border: #e0e0e0;
    --chat-accent: #eb0028;
    --chat-red-dark: #b0001e;   /* rouge sombre */
    --chat-red-mid: #eb0028;    /* rouge principal */
    --chat-red-light: #ff1a3a;  /* rouge clair */
    --chat-text: #1a1a1a;
    --chat-muted: #888888;
    --chat-radius: 16px;
    --gradient-red: linear-gradient(135deg, #6b0010, #b0001e, #eb0028);
    --shadow-red: 0 0 30px rgba(176, 0, 30, 0.18);
  }

  /* ---- Toggle ---- */
  #sikipon-toggle {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--gradient-red);
    border: none;
    cursor: pointer;
    z-index: 9999;
    box-shadow: 0 4px 20px rgba(107, 0, 16, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  #sikipon-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 28px rgba(107, 0, 16, 0.7);
  }
  #sikipon-toggle svg { width: 26px; height: 26px; fill: white; }

  /* ---- Fenêtre ---- */
  #sikipon-window {
    position: fixed;
    bottom: 2px;
    right: 28px;
    width: 400px;
    height: 580px;
    background: var(--chat-bg);
    border: 1px solid var(--chat-border);
    border-radius: var(--chat-radius);
    display: flex;
    flex-direction: column;
    z-index: 9998;
    box-shadow: var(--shadow-red), 0 20px 60px rgba(0,0,0,0.13);
    font-family: 'Segoe UI', Arial, sans-serif;
    transform: scale(0.85) translateY(20px);
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  #sikipon-window.open {
    transform: scale(1) translateY(0);
    opacity: 1;
    pointer-events: all;
  }

  /* ---- Header ---- */
  .sk-header {
    padding: 14px 18px;
    background: var(--gradient-red);
    border-radius: var(--chat-radius) var(--chat-radius) 0 0;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 2px 12px rgba(107, 0, 16, 0.25);
  }
  .sk-avatar {
    width: 36px; height: 36px;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(255,255,255,0.35);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
  }
  .sk-header-info { flex: 1; }
  .sk-name { font-weight: 700; font-size: 14px; color: #fff; letter-spacing: 0.3px; }
  .sk-status {
    font-size: 11px; color: rgba(255,255,255,0.85);
    display: flex; align-items: center; gap: 4px;
  }
  .sk-status::before {
    content: ''; width: 6px; height: 6px;
    background: #fff; border-radius: 50%;
    display: inline-block; animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

  .sk-close {
    background: rgba(255,255,255,0.15);
    border: none; color: white; cursor: pointer;
    font-size: 18px; width: 28px; height: 28px;
    border-radius: 50%; display: flex;
    align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .sk-close:hover { background: rgba(255,255,255,0.3); }

  /* ---- Messages ---- */
  .sk-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fafafa;
    scrollbar-width: thin;
    scrollbar-color: #e0e0e0 transparent;
  }

  .sk-msg {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.6;
    animation: msgIn 0.2s ease;
  }
  @keyframes msgIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }

  .sk-msg.bot {
    background: #ffffff;
    border: 1px solid #e8e8e8;
    color: #1a1a1a;
    align-self: flex-start;
    border-bottom-left-radius: 4px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }
  .sk-msg.user {
    background: var(--gradient-red);
    color: white;
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    box-shadow: 0 2px 10px rgba(107, 0, 16, 0.35);
  }
  .sk-msg.typing {
    background: #ffffff;
    border: 1px solid #e8e8e8;
    align-self: flex-start;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }
  .typing-dots { display:flex; gap:4px; padding:2px 0; }
  .typing-dots span {
    width:6px; height:6px;
    background: var(--chat-red-dark);
    border-radius:50%;
    animation: bounce 1.2s infinite;
  }
  .typing-dots span:nth-child(2){animation-delay:.2s}
  .typing-dots span:nth-child(3){animation-delay:.4s}
  @keyframes bounce { 0%,80%,100%{transform:translateY(0)} 40%{transform:translateY(-6px)} }

  /* ---- Quick Replies ---- */
  .sk-quick-replies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 4px 0 8px 0;
    animation: msgIn 0.3s ease;
  }
  .sk-quick-replies.hidden { display: none; }

  .sk-quick-btn {
    padding: 7px 13px;
    border: 1.5px solid var(--chat-red-dark);
    border-radius: 20px;
    color: var(--chat-red-dark);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    background: #ffffff;
    transition: all 0.18s ease;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgba(107, 0, 16, 0.1);
    user-select: none;
  }
  .sk-quick-btn:hover {
    background: var(--gradient-red);
    color: #ffffff;
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(107, 0, 16, 0.3);
  }
  .sk-quick-btn:active { transform: translateY(0); }

  /* ---- Input Zone ---- */
  .sk-input-zone {
    padding: 12px 14px;
    background: #ffffff;
    border-top: 1px solid var(--chat-border);
    border-radius: 0 0 var(--chat-radius) var(--chat-radius);
  }

  .sk-autocomplete-wrap {
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: 'Courier New', monospace;
    font-size: 13px;
  }
  .sk-autocomplete-wrap:focus-within {
    border-color: var(--chat-red-dark);
    box-shadow: 0 0 0 3px rgba(107, 0, 16, 0.08);
  }

  .sk-ghost {
    position: absolute;
    left: 12px; top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    width: calc(100% - 50px);
    display: flex;
  }
  .sk-ghost-typed { color: transparent; white-space: pre; }
  .sk-ghost-suggestion { color: #b0001e; opacity: 0.4; white-space: pre; }

  #sk-input {
    position: relative; z-index: 1;
    flex: 1; background: transparent;
    border: none; outline: none;
    color: #1a1a1a;
    padding: 11px 12px;
    font-family: 'Courier New', monospace;
    font-size: 13px;
    caret-color: var(--chat-red-dark);
  }
  #sk-input::placeholder { color: #aaaaaa; font-family: 'Segoe UI', Arial, sans-serif; }

  .sk-tab-hint { font-size:10px; color:#aaa; padding-right:8px; white-space:nowrap; }
  .sk-tab-key {
    background: #f0f0f0; color: #555;
    border: 1px solid #ddd; border-radius: 4px;
    padding: 1px 5px; font-size: 9px;
    font-family: 'Courier New', monospace;
  }

  .sk-send-btn {
    margin-top: 8px; width: 100%; padding: 10px;
    background: var(--gradient-red);
    border: none; border-radius: 8px;
    color: white; font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px; font-weight: 700;
    cursor: pointer; letter-spacing: 0.3px;
    transition: opacity 0.2s, transform 0.1s, box-shadow 0.2s;
    box-shadow: 0 3px 12px rgba(107, 0, 16, 0.35);
  }
  .sk-send-btn:hover {
    opacity: 0.92; transform: translateY(-1px);
    box-shadow: 0 5px 16px rgba(107, 0, 16, 0.45);
  }
  .sk-send-btn:active { transform: translateY(0); }
  .sk-send-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .sk-hint-text {
    text-align: center; font-size: 10px;
    color: #bbb; margin-top: 6px;
    font-family: 'Segoe UI', Arial, sans-serif;
  }
  .sk-hint-text span { color: var(--chat-red-dark); font-weight: 700; }
