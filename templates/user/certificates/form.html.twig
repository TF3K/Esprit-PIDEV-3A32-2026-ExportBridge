{% extends 'user/base_user.html.twig' %}
{% block title %}{{ mode == 'edit' ? 'Edit Certificate' : 'Add Certificate' }}{% endblock %}
{% block user_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">{{ mode == 'edit' ? 'Edit Certificate' : 'Add Certificate' }}</h3>
    <p class="text-muted mb-0">Company: {{ company ? company.companyName : 'N/A' }}</p>
    {% if certificate.partnership %}<p class="text-muted mb-0">Linked Partnership: {{ certificate.partnership.type ?? ('#' ~ certificate.partnership.id) }}</p>{% endif %}
  </div>
  <a href="{{ path('app_user_certificates') }}" class="btn btn-outline-secondary">Back</a>
</div>
{% for label, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label == 'error' ? 'danger' : label }} mb-3">{{ message }}</div>{% endfor %}{% endfor %}
<div class="card shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <div style="max-width:260px;width:100%">
        <label class="form-label small text-muted">Form language</label>
        <select id="formLang" class="form-select">
          <option value="en">English</option>
          <option value="fr">Français</option>
          <option value="ar">العربية</option>
        </select>
      </div>
    </div>
    <form method="post" enctype="multipart/form-data" id="certificateForm">
      <div class="alert alert-primary border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #f4f8ff, #eef7ff);">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
          <div>
            <h5 class="mb-1">AI Auto-Fill Certificate</h5>
            <div class="text-muted small">Choose the certificate PDF below. Demo mode works without paid API credits; real AI extraction works after adding OpenAI billing.</div>
          </div>
          <button type="button" class="btn btn-primary" id="aiExtractBtn" data-url="{{ path('app_user_certificate_ai_extract') }}">
            Extract with AI
          </button>
        </div>
        <div id="aiExtractResult" class="mt-3 d-none"></div>
      </div>

      <div class="row g-3">
        <div class="col-md-6"><label class="form-label" data-i18n="cert_number">Certificate Number *</label><input class="form-control" name="certificate_number" value="{{ certificate.certificateNumber }}" required></div>
        <div class="col-md-6"><label class="form-label" data-i18n="type">Type *</label><input class="form-control" name="type" value="{{ certificate.type }}" required></div>
        <div class="col-md-6"><label class="form-label" data-i18n="issuing">Issuing Authority</label><input class="form-control" name="issuing_authority" value="{{ certificate.issuingAuthority }}"></div>
        <div class="col-md-6"><label class="form-label" data-i18n="issue_date">Issue Date</label><input type="date" class="form-control" name="issue_date" value="{{ certificate.issueDate ? certificate.issueDate|date('Y-m-d') : '' }}"></div>
        <div class="col-md-6"><label class="form-label" data-i18n="expiry_date">Expiry Date</label><input type="date" class="form-control" name="expiry_date" value="{{ certificate.expiryDate ? certificate.expiryDate|date('Y-m-d') : '' }}"></div>
        <div class="col-md-6"><label class="form-label" data-i18n="country">Country of Origin</label><input class="form-control" name="country_of_origin" value="{{ certificate.countryOfOrigin }}"></div>
        <div class="col-12">
          <label class="form-label" data-i18n="file">Certificate PDF file</label>
          <input type="file" class="form-control" name="document_file" id="certificatePdfFile" accept="application/pdf,.pdf">
          {% if mode == 'edit' and certificate.documentFile %}
            <div class="form-text mt-2">
              Current file exists. Upload a new PDF only if you want to replace it.
              <a href="{{ path('app_user_certificate_open_uploaded_pdf', {'id': certificate.id}) }}" target="_blank">Open current PDF</a>
            </div>
          {% else %}
            <div class="form-text">Optional. Upload a PDF document for this certificate. Required only if you want to use AI Auto-Fill.</div>
          {% endif %}
        </div>
      </div>
      <div class="mt-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary">{{ mode == 'edit' ? 'Update' : 'Add' }}</button>
        {% if mode == 'edit' %}
          <a class="btn btn-outline-success" href="{{ path('app_user_certificate_pdf', {'id': certificate.id}) }}">Download detailed PDF</a>
        {% endif %}
        <a href="{{ path('app_user_certificates') }}" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<script>
const dict={
 en:{cert_number:'Certificate Number *',type:'Type *',issuing:'Issuing Authority',issue_date:'Issue Date',expiry_date:'Expiry Date',country:'Country of Origin',file:'Certificate PDF file'},
 fr:{cert_number:'Numéro du certificat *',type:'Type *',issuing:'Autorité émettrice',issue_date:'Date de délivrance',expiry_date:'Date d\'expiration',country:'Pays d\'origine',file:'Fichier PDF du certificat'},
 ar:{cert_number:'رقم الشهادة *',type:'النوع *',issuing:'الجهة المصدرة',issue_date:'تاريخ الإصدار',expiry_date:'تاريخ الانتهاء',country:'بلد المنشأ',file:'ملف PDF للشهادة'}
};
document.getElementById('formLang')?.addEventListener('change',function(){const lang=dict[this.value]||dict.en;document.querySelectorAll('[data-i18n]').forEach(el=>{el.textContent=lang[el.dataset.i18n]||el.textContent;});document.documentElement.dir=this.value==='ar'?'rtl':'ltr';});

const aiExtractBtn = document.getElementById('aiExtractBtn');
const aiExtractResult = document.getElementById('aiExtractResult');
const certificatePdfFile = document.getElementById('certificatePdfFile');
const certificateForm = document.getElementById('certificateForm');

function setAiResult(html, type = 'info') {
  if (!aiExtractResult) return;
  aiExtractResult.className = `alert alert-${type} mt-3 mb-0`;
  aiExtractResult.innerHTML = html;
}

function fillField(name, value) {
  if (!value || !certificateForm) return false;
  const input = certificateForm.querySelector(`[name="${name}"]`);
  if (!input) return false;
  input.value = value;
  input.classList.add('border-primary');
  setTimeout(() => input.classList.remove('border-primary'), 2500);
  return true;
}

aiExtractBtn?.addEventListener('click', async function () {
  const file = certificatePdfFile?.files?.[0];
  if (!file) {
    setAiResult('Please choose a certificate PDF first.', 'warning');
    return;
  }

  if (file.type && file.type !== 'application/pdf') {
    setAiResult('Please choose a valid PDF file.', 'warning');
    return;
  }

  const originalText = aiExtractBtn.textContent;
  aiExtractBtn.disabled = true;
  aiExtractBtn.textContent = 'Extracting...';
  setAiResult('AI is reading the PDF and preparing the form fields...', 'info');

  const formData = new FormData();
  formData.append('ai_certificate_file', file);

  try {
    const response = await fetch(aiExtractBtn.dataset.url, {
      method: 'POST',
      body: formData,
      headers: {'X-Requested-With': 'XMLHttpRequest'}
    });
    const data = await response.json();

    if (!response.ok || !data.success) {
      setAiResult(data.message || 'AI extraction failed. Please try again.', 'danger');
      return;
    }

    let filled = 0;
    Object.entries(data.fields || {}).forEach(([name, value]) => {
      if (fillField(name, value)) filled++;
    });

    const warnings = (data.warnings || []).map(w => `<li>${String(w).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</li>`).join('');
    const summary = data.summary ? `<div class="mt-2"><strong>Summary:</strong> ${String(data.summary).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</div>` : '';
    const warningBlock = warnings ? `<div class="mt-2"><strong>Warnings:</strong><ul class="mb-0">${warnings}</ul></div>` : '';

    const demoBadge = data.demo_mode ? '<span class="badge bg-warning text-dark ms-2">Demo mode</span>' : '';
    setAiResult(`AI filled ${filled} field(s). Confidence: <strong>${data.confidence || 0}%</strong>${demoBadge}. Please review before saving.${summary}${warningBlock}`, 'success');
  } catch (error) {
    setAiResult('AI extraction failed. Check your internet connection and OpenAI API key.', 'danger');
  } finally {
    aiExtractBtn.disabled = false;
    aiExtractBtn.textContent = originalText;
  }
});
</script>
{% endblock %}
