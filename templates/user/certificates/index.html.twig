{% extends 'user/base_user.html.twig' %}

{% block title %}My Certificates - ExportBridge{% endblock %}

{% block user_content %}
<div class="row mb-4">
  <div class="col-12 d-sm-flex justify-content-between align-items-center">
    <div>
      <h3 class="mb-0">All Certificates</h3>
      <p class="text-muted mb-0">Certificates linked to your company.</p>
    </div>
    <a class="btn btn-primary mt-3 mt-sm-0" href="{{ path('app_user_certificate_new') }}">
      <i class="bi bi-plus-circle me-2"></i>Add Certificate
    </a>
  </div>
</div>

{% for label, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} border mb-3">{{ message }}</div>
  {% endfor %}
{% endfor %}

<div class="row g-4 mb-4">
  <div class="col-lg-12">
    <div class="card border bg-transparent rounded-3 h-100">
      <div class="card-header bg-transparent border-bottom">
        <h5 class="mb-0">Company Localisation</h5>
      </div>
      <div class="card-body">
        <p class="mb-2"><strong>Company:</strong> {{ company ? company.companyName : 'N/A' }}</p>
        <p class="mb-3"><strong>Address:</strong> {{ company and company.address ? company.address : 'No address available.' }}</p>
        {% if company and company.address %}
          <div class="ratio ratio-16x9 border rounded overflow-hidden mb-3">
            <iframe src="https://maps.google.com/maps?q={{ company.address|url_encode }}&t=&z=13&ie=UTF8&iwloc=&output=embed" style="border:0;" loading="lazy"></iframe>
          </div>
          <a class="btn btn-outline-primary btn-sm" target="_blank" href="https://maps.google.com/?q={{ company.address|url_encode }}">Open localisation map</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% set activeCount = 0 %}
{% set pendingCount = 0 %}
{% set expiredCount = 0 %}
{% for cert in certificates %}
  {% if cert.status == 'active' %}{% set activeCount = activeCount + 1 %}{% endif %}
  {% if cert.status == 'pending' %}{% set pendingCount = pendingCount + 1 %}{% endif %}
  {% if cert.status == 'expired' %}{% set expiredCount = expiredCount + 1 %}{% endif %}
{% endfor %}

<div class="row g-4 mb-4">
  <div class="col-sm-6 col-lg-3"><div class="text-center p-3 bg-primary bg-opacity-10 border border-primary rounded-3"><h6>Total</h6><h3 class="mb-0 text-primary">{{ certificates|length }}</h3></div></div>
  <div class="col-sm-6 col-lg-3"><div class="text-center p-3 bg-success bg-opacity-10 border border-success rounded-3"><h6>Active</h6><h3 class="mb-0 text-success">{{ activeCount }}</h3></div></div>
  <div class="col-sm-6 col-lg-3"><div class="text-center p-3 bg-warning bg-opacity-10 border border-warning rounded-3"><h6>Pending</h6><h3 class="mb-0 text-warning">{{ pendingCount }}</h3></div></div>
  <div class="col-sm-6 col-lg-3"><div class="text-center p-3 bg-danger bg-opacity-10 border border-danger rounded-3"><h6>Expired</h6><h3 class="mb-0 text-danger">{{ expiredCount }}</h3></div></div>
</div>

<div class="card border bg-transparent rounded-3">
  <div class="card-header bg-transparent border-bottom">
    <div class="row g-3">
      <div class="col-12 col-md-5">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input class="form-control bg-body" type="search" id="certSearch" placeholder="Search certificates...">
        </div>
      </div>
      <div class="col-6 col-md-3">
        <select class="form-select" id="certStatusFilter">
          <option value="">All Statuses</option>
          <option value="active">Active</option>
          <option value="pending">Pending</option>
          <option value="expired">Expired</option>
          <option value="revoked">Revoked</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <select class="form-select" id="certSort">
          <option value="number-asc">Number A-Z</option>
          <option value="type-asc">Type A-Z</option>
          <option value="expiry-asc">Expiry earliest</option>
          <option value="expiry-desc">Expiry latest</option>
        </select>
      </div>
      <div class="col-12 col-md-2 d-flex align-items-center">
        <small class="text-muted" id="certResultCount"></small>
      </div>
    </div>
  </div>

  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" id="certsTable">
        <thead>
          <tr>
            <th>Certificate #</th>
            <th>Type</th>
            <th>Issuing Authority</th>
            <th>Issue Date</th>
            <th>Expiry Date</th>
            <th>Status</th>
            <th>Partnership</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for cert in certificates %}
            <tr>
              <td><code>{{ cert.certificateNumber }}</code></td>
              <td>{{ cert.type }}</td>
              <td>{{ cert.issuingAuthority ?? '-' }}</td>
              <td data-sort="{{ cert.issueDate ? cert.issueDate|date('Y-m-d') : '' }}">{{ cert.issueDate ? cert.issueDate|date('d/m/Y') : '-' }}</td>
              <td data-sort="{{ cert.expiryDate ? cert.expiryDate|date('Y-m-d') : '' }}">{{ cert.expiryDate ? cert.expiryDate|date('d/m/Y') : '-' }}</td>
              <td>
                {% if cert.status == 'active' %}
                  <span class="badge text-bg-success">Active</span>
                {% elseif cert.status == 'pending' %}
                  <span class="badge text-bg-warning">Pending</span>
                {% elseif cert.status == 'expired' %}
                  <span class="badge text-bg-danger">Expired</span>
                {% else %}
                  <span class="badge text-bg-secondary">{{ cert.status|capitalize }}</span>
                {% endif %}
              </td>
              <td>
                {% if cert.partnership %}
                  <a href="{{ path('app_user_partnership_show', {'id': cert.partnership.id}) }}">{{ cert.partnership.type ?? ('#' ~ cert.partnership.id) }}</a>
                {% else %}
                  -
                {% endif %}
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end flex-wrap gap-1">
                  <a class="btn btn-sm btn-outline-dark" href="{{ path('app_user_certificate_show', {'id': cert.id}) }}">View</a>
                  <a class="btn btn-sm btn-outline-primary" href="{{ path('app_user_certificate_edit', {'id': cert.id}) }}">Edit</a>
                  <a class="btn btn-sm btn-outline-success" href="{{ path('app_user_certificate_pdf', {'id': cert.id}) }}">PDF</a>
                  <a class="btn btn-sm btn-outline-info" href="{{ path('app_user_certificate_qr', {'id': cert.id}) }}" target="_blank">QR</a>
                  {% if cert.documentFile %}
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_user_certificate_open_uploaded_pdf', {'id': cert.id}) }}" target="_blank">Uploaded</a>
                  {% endif %}
                  <form method="post" action="{{ path('app_user_certificate_delete', {'id': cert.id}) }}" onsubmit="return confirm('Delete this certificate?');">
                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          {% else %}
            <tr data-empty-row="true">
              <td colspan="8" class="text-center text-muted py-4">No certificates found for your company.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
  const rows = () => [...document.querySelectorAll('#certsTable tbody tr:not([data-empty-row])')];
  const searchInput = document.getElementById('certSearch');
  const statusFilter = document.getElementById('certStatusFilter');
  const sortSelect = document.getElementById('certSort');
  const countEl = document.getElementById('certResultCount');

  function normalize(value) {
    return (value || '').toLowerCase().trim();
  }

  function cellText(row, selector) {
    const el = row.querySelector(selector);
    return el ? normalize(el.dataset.sort || el.textContent) : '';
  }

  function applyCertificateList() {
    const query = normalize(searchInput.value);
    const status = normalize(statusFilter.value);
    const sort = sortSelect.value;

    const visible = rows().filter(row => {
      const matchSearch = !query || ['td:nth-child(1)', 'td:nth-child(2)', 'td:nth-child(3)', 'td:nth-child(7)'].some(selector => cellText(row, selector).includes(query));
      const matchStatus = !status || cellText(row, 'td:nth-child(6)').includes(status);
      row.style.display = (matchSearch && matchStatus) ? '' : 'none';
      return matchSearch && matchStatus;
    });

    const sortMap = {
      'number-asc': { col: 0, dir: 'asc' },
      'type-asc': { col: 1, dir: 'asc' },
      'expiry-asc': { col: 4, dir: 'asc' },
      'expiry-desc': { col: 4, dir: 'desc' },
    };
    const sortConfig = sortMap[sort];

    if (sortConfig) {
      const tbody = document.querySelector('#certsTable tbody');
      visible.sort((a, b) => {
        const va = cellText(a, `td:nth-child(${sortConfig.col + 1})`);
        const vb = cellText(b, `td:nth-child(${sortConfig.col + 1})`);
        if (va < vb) return sortConfig.dir === 'asc' ? -1 : 1;
        if (va > vb) return sortConfig.dir === 'asc' ? 1 : -1;
        return 0;
      }).forEach(row => tbody.appendChild(row));
    }

    countEl.textContent = `${visible.length} result${visible.length !== 1 ? 's' : ''}`;
  }

  searchInput.addEventListener('input', applyCertificateList);
  statusFilter.addEventListener('change', applyCertificateList);
  sortSelect.addEventListener('change', applyCertificateList);
  applyCertificateList();
})();
</script>
{% endblock %}
