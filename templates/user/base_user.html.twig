{% extends 'base.html.twig' %}

{% block body %}

    {% include 'user/partials/navbar.html.twig' %}

    {# Profile banner #}
    <section class="pt-0">
        <div class="container-fluid px-0">
            <div class="bg-blue h-100px h-md-200px rounded-0"
                 style="background:url({{ asset('assets/images/pattern/04.png') }}) no-repeat center center; background-size:cover;">
            </div>
        </div>
        <div class="container mt-n4">
            <div class="row">
                <div class="col-12">
                    <div class="card bg-transparent card-body p-0">
                        <div class="row d-flex justify-content-between">
                            <div class="col-auto mt-4 mt-md-0">
                                <div class="avatar avatar-xxl mt-n3">
                                    <img class="avatar-img rounded-circle border border-white border-3 shadow"
                                         src="{{ asset('assets/images/avatar/01.jpg') }}" alt="">
                                </div>
                            </div>
                            <div class="col d-md-flex justify-content-between align-items-center mt-4">
                                <div>
                                    <h1 class="my-1 fs-4">
                                        {{ app.user.firstName }} {{ app.user.lastName }}
                                    </h1>
                                    <ul class="list-inline mb-0">
                                        <li class="list-inline-item h6 fw-light me-3">
                                            <i class="bi bi-envelope text-primary me-2"></i>{{ app.user.email }}
                                        </li>
                                        {% if app.user.company %}
                                        <li class="list-inline-item h6 fw-light me-3">
                                            <i class="bi bi-building text-orange me-2"></i>{{ app.user.company.companyName }}
                                        </li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Main content with sidebar #}
    <section class="pt-0">
        <div class="container">
            <div class="row">

                {# Left sidebar #}
                <div class="col-xl-3">
                    <div class="offcanvas-xl offcanvas-end" tabindex="-1" id="offcanvasSidebar">
                        <div class="offcanvas-header bg-light">
                            <h5 class="offcanvas-title">My Profile</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#offcanvasSidebar"></button>
                        </div>
                        <div class="offcanvas-body p-3 p-xl-0">
                            <div class="bg-dark border rounded-3 pb-0 p-3 w-100">
                                <div class="list-group list-group-dark list-group-borderless">
                                    <a class="list-group-item {% if app.request.get('_route') == 'app_dashboard' %}active{% endif %}"
                                       href="{{ path('app_dashboard') }}">
                                        <i class="bi bi-ui-checks-grid fa-fw me-2"></i>Dashboard
                                    </a>
                                    {# <a class="list-group-item {% if app.request.get('_route') starts with 'app_user_products' %}active{% endif %}"
                                       href="{{ path('app_user_products') }}">
                                        <i class="bi bi-box-seam fa-fw me-2"></i>My Products
                                    </a>
                                    <a class="list-group-item {% if app.request.get('_route') starts with 'app_user_certificates' %}active{% endif %}"
                                       href="{{ path('app_user_certificates') }}">
                                        <i class="bi bi-patch-check fa-fw me-2"></i>My Certificates
                                    </a> #}
                                    <a class="list-group-item text-danger bg-danger-soft-hover"
                                       href="{{ path('app_logout') }}">
                                        <i class="fas fa-sign-out-alt fa-fw me-2"></i>Sign Out
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {# Left sidebar END #}

                {# Main content #}
                <div class="col-xl-9">
                    {% block user_content %}{% endblock %}
                </div>

            </div>
        </div>
    </section>

{% endblock %}