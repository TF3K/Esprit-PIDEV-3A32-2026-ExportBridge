        <script>
            document.addEventListener('DOMContentLoaded', function () {

                if (typeof AOS !== 'undefined') {
                    AOS.init({
                        duration: 800,
                        once: true
                    });
                }

            });

               
document.addEventListener("DOMContentLoaded", function () {
    let oldTotal = 0;
    const audio = document.getElementById("notifSound");

    function loadUpdates() {
        fetch("http://127.0.0.1:3000/api/latest-updates")
        .then(res => res.json())
        .then(data => {
            if (data.error) return;

            const total = data.total;
            
            // Mise à jour des éléments HTML
            if(document.getElementById("notifCount")) document.getElementById("notifCount").textContent = total;
            if(document.getElementById("notifBadge")) document.getElementById("notifBadge").textContent = total;
            if(document.getElementById("newCompany")) document.getElementById("newCompany").textContent = data.last_company?.company_name || "---";
            if(document.getElementById("newMarket")) document.getElementById("newMarket").textContent = data.last_market?.name || "---";
            if(document.getElementById("notifTime")) document.getElementById("notifTime").textContent = data.time;

            // Alerte si nouveau contenu
            if (oldTotal !== 0 && total > oldTotal) {
                if(audio) audio.play();
                showNotification(`🔔 Nouveau contenu disponible !<br>Total : ${total}`);
            }
            oldTotal = total;
        })
        .catch(err => console.error("Erreur Fetch:", err));
    }

    function showNotification(message) {
        let box = document.createElement("div");
        box.innerHTML = message;
        Object.assign(box.style, {
            position: "fixed", top: "20px", right: "20px",
            background: "#111", color: "#fff", padding: "15px",
            borderRadius: "10px", zIndex: "9999", boxShadow: "0 10px 25px rgba(0,0,0,.2)"
        });
        document.body.appendChild(box);
        setTimeout(() => box.remove(), 5000);
    }

    loadUpdates();
    setInterval(loadUpdates, 10000); // 10 secondes pour ne pas surcharger le serveur
});
document.addEventListener("DOMContentLoaded", function() {
    const fullScreenBtn = document.getElementById('full-screen-btn');
    const icon = fullScreenBtn.querySelector('i');

    fullScreenBtn.addEventListener('click', function() {
        if (!document.fullscreenElement) {
            // Entrer en mode plein écran
            document.documentElement.requestFullscreen().catch(err => {
                console.error(`Erreur : ${err.message}`);
            });
            icon.classList.replace('ph-corners-out', 'ph-corners-in');
        } else {
            // Quitter le mode plein écran
            if (document.exitFullscreen) {
                document.exitFullscreen();
                icon.classList.replace('ph-corners-in', 'ph-corners-out');
            }
        }
    });

    // Gérer le changement via la touche Echap (Esc)
    document.addEventListener('fullscreenchange', function() {
        if (!document.fullscreenElement) {
            icon.classList.replace('ph-corners-in', 'ph-corners-out');
        }
    });
});


</script>
