emailjs.init("{{ emailjs_public_key }}");

document.getElementById("newsletter-form").addEventListener("submit", function(e) {
    e.preventDefault();

    // On récupère le bouton pour donner un feedback visuel
    const btn = this.querySelector('.news-btn');
    const originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

    emailjs.sendForm(
        "{{ emailjs_service_id }}",
        "{{ emailjs_template_id }}",
        this // 'this' fait bien référence au formulaire ici
    ).then(() => {
        alert("Email sent successfully!");
        this.reset();
    }).catch((error) => {
        console.error("EmailJS error:", error);
        // Utiliser error.status ou error.text pour plus de clarté
        alert("Error: " + (error.text || "Check console for details"));
    }).finally(() => {
        btn.disabled = false;
        btn.innerHTML = originalContent;
    });
});
am5.ready(function() {

// ============================================================
// ExportBRIDGE — Tunisie Hub Commercial Mondial
// Tunisie → Monde (Export élargi)
