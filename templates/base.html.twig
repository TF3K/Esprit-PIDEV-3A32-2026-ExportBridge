      <script>
        // =====================================================
        // 1. LOADER — affiché uniquement au démarrage de session
        // =====================================================
        (function () {
          const loader = document.getElementById('loader-wrapper');
          if (!loader) return;

          if (!sessionStorage.getItem('loader-shown')) {
            // Première page de la session → afficher le loader
            loader.classList.add('active');

            const hideLoader = function () {
              loader.classList.add('hide'); // déclenche le fondu CSS
              setTimeout(function () {
                loader.classList.remove('active', 'hide');
                sessionStorage.setItem('loader-shown', 'true');
              }, 500); // durée = transition CSS opacity
            };

            // Fallback si window.load ne se déclenche pas dans les 3s
            const fallback = setTimeout(hideLoader, 3000);

            window.addEventListener('load', function () {
              clearTimeout(fallback);
              hideLoader();
            });

          } else {
            // Déjà vu dans cette session → retirer immédiatement
            loader.remove();
          }
        })();


        // =====================================================
        // 2. INITIALISATION DES COMPOSANTS AU DOM READY
        // =====================================================
        document.addEventListener('DOMContentLoaded', function () {

          // ----- AOS -----
          AOS.init({ duration: 1000, once: false });

          // ----- CAROUSEL + AOS -----
          const myCarousel = document.getElementById('homepageCarousel');
          if (myCarousel) {
            myCarousel.addEventListener('slide.bs.carousel', function () {
              myCarousel.querySelectorAll('[data-aos]').forEach(function (el) {
                el.classList.remove('aos-animate');
              });
            });

            myCarousel.addEventListener('slid.bs.carousel', function (e) {
              AOS.refreshHard();
              e.relatedTarget.querySelectorAll('[data-aos]').forEach(function (el) {
                el.classList.add('aos-animate');
              });
            });
          }

          // ----- STICKY HEADER -----
          const header = document.querySelector('.for-sticky');
          if (header) {
            window.addEventListener('scroll', function () {
              const currentScroll = window.pageYOffset;
              if (currentScroll > 0 && currentScroll <= 100) {
                header.classList.add('hide');
              } else {
                header.classList.remove('hide');
              }
            });
          }

          // ----- CHATBOT SIKIPON -----
          const chatForm = document.getElementById('chatbot-form');
          if (chatForm) {
            chatForm.addEventListener('submit', function (e) {
              e.preventDefault();

              const btnText          = document.getElementById('btn-text');
              const btnLoader        = document.getElementById('btn-loader');
              const btnSubmit        = document.getElementById('btn-submit');
              const responseContainer = document.getElementById('response-container');
              const botAnswer        = document.getElementById('bot-answer');
              const alertStatus      = document.getElementById('alert-status');

              // État : chargement
              btnText.innerText = 'Sikipon réfléchit...';
              btnLoader.classList.remove('d-none');
              btnSubmit.disabled = true;

              fetch('http://localhost:3000/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  email:    document.getElementById('email').value,
                  question: document.getElementById('question').value
                })
              })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                  btnText.innerText = 'Interroger Sikipon';
                  btnLoader.classList.add('d-none');
                  btnSubmit.disabled = false;

                  if (data.status === 'success') {
                    responseContainer.classList.remove('d-none');
                    botAnswer.innerText = data.answer;

                    alertStatus.className = 'alert alert-success';
                    alertStatus.innerText = 'Email envoyé avec succès !';
                    alertStatus.classList.remove('d-none');

                    localStorage.setItem('last_sikipon_question', document.getElementById('question').value);
                  }
                })
                .catch(function (error) {
                  btnText.innerText = 'Réessayer';
                  btnLoader.classList.add('d-none');
                  btnSubmit.disabled = false;

                  alertStatus.className = 'alert alert-danger';
                  alertStatus.innerText = 'Erreur : Impossible de joindre Sikipon (Vérifiez que le serveur Python tourne).';
                  alertStatus.classList.remove('d-none');

                  console.error('Sikipon error:', error);
                });
            });
          }

        }); // fin DOMContentLoaded
        
    async function updateSikiponNews() {
        try {
            const response = await fetch('http://localhost:3000/api/latest-updates');
            const data = await response.json();
            const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

            // --- FONCTION POUR EXTRAIRE LA DATE DEPUIS L'ATTRIBUT CREATED_AT ---
            function setElementDate(block, dateString) {
                if (!dateString || dateString === "None") return;
                
                // On transforme la string SQL (YYYY-MM-DD HH:MM:SS) en objet Date JS
                const d = new Date(dateString);
                
                // On vérifie si la date est valide avant de l'afficher
                if (!isNaN(d.getTime())) {
                    const dayEl = block.querySelector('.news-day');
                    const monthEl = block.querySelector('.news-month');
                    
                    if (dayEl) dayEl.innerText = d.getDate(); // Récupère le jour (ex: 17)
                    if (monthEl) monthEl.innerText = months[d.getMonth()]; // Récupère le mois (ex: Apr)
                }
            }

            // --- BLOC 1 : COMPANY ---
            const blockCompany = document.getElementById('news-company');
            if (blockCompany && data.last_company) {
                // On utilise explicitement l'attribut created_at de l'entité Company
                setElementDate(blockCompany, data.last_company.created_at);
                
                if (blockCompany.querySelector('.news-title')) {
                    blockCompany.querySelector('.news-title').innerText = data.last_company.company_name;
                }
                if (blockCompany.querySelector('.news-desc')) {
                    blockCompany.querySelector('.news-desc').innerText = "Entreprise ajoutée en " + data.last_company.country;
                }
            }

            // --- BLOC 2 : MARKET ---
            const blockMarket = document.getElementById('news-market');
            if (blockMarket && data.last_market) {
                // On utilise explicitement l'attribut created_at de l'entité Market
                setElementDate(blockMarket, data.last_market.created_at);
                
                if (blockMarket.querySelector('.news-title')) {
                    blockMarket.querySelector('.news-title').innerText = "Marché : " + data.last_market.name;
                }
                if (blockMarket.querySelector('.news-desc')) {
                    blockMarket.querySelector('.news-desc').innerText = "Nouveau marché : " + data.last_market.region;
                }
            }

        } catch (error) {
            console.error('Erreur Sikipon (Fetch ou SQL) :', error);
        }
    }

    document.addEventListener('DOMContentLoaded', updateSikiponNews);

 // Assurez-vous que les variables sont bien entourées de guillemets 
