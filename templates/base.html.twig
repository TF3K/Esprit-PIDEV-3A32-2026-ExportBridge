  centerY: am5.p50,
  text: "Globe",
  fill: flare,
  fontSize: 13
}));

var switchButton = switchCont.children.push(am5.Button.new(root, {
  themeTags: ["switch"],
  centerY: am5.p50,
  icon: am5.Circle.new(root, {
    themeTags: ["icon"]
  })
}));

var easing = am5.ease.inOut(am5.ease.cubic);
var duration = 1500;

function zoomToGlobe() {
  chart.set("projection", am5map.geoOrthographic());
  chart.set("panX", "rotateX");
  chart.set("panY", "rotateY");
  chart.animate({ key: "rotationX", to: -74, duration, easing });
  chart.animate({ key: "rotationY", to: -30, duration, easing });
  chart.animate({ key: "zoomLevel", to: 1.6, duration, easing });
  bgSeries.mapPolygons.template.set("fillOpacity", 1);
}

function zoomToMap() {
  chart.set("projection", am5map.geoMercator());
  chart.set("panX", "translateX");
  chart.set("panY", "translateY");
  chart.animate({ key: "rotationY", to: 0, duration, easing });
  setTimeout(function() {
    chart.zoomToGeoPoint({ longitude: 67, latitude: 32 }, 3.5, true, duration);
  }, 100);
  bgSeries.mapPolygons.template.set("fillOpacity", 0);
}

var fadeDuration = 300;

switchButton.on("active", function() {
  chart.goHome(duration);
  // Fade out before projection switch
  setTimeout(function() {
    chart.seriesContainer.animate({ key: "opacity", to: 0, duration: fadeDuration });
  }, duration - fadeDuration);
  setTimeout(function() {
    if (switchButton.get("active")) {
      zoomToMap();
    } else {
      zoomToGlobe();
    }
    // Fade in after projection switch
    chart.seriesContainer.animate({ key: "opacity", to: 1, duration: fadeDuration });
  }, duration);
});

switchCont.children.push(am5.Label.new(root, {
  centerY: am5.p50,
  text: "Map",
  fill: flare,
  fontSize: 13
}));

// ---- Zoom controls with home button ----
var zoomControl = chart.set("zoomControl", am5map.ZoomControl.new(root, {}));
zoomControl.homeButton.set("visible", true);


chart.appear(1000, 100);

// Initial animation: rotate to globe position, then zoom in
setTimeout(function() {
  zoomToGlobe();
}, 1000);


});
(function () {
  const FLASK_URL = 'http://localhost:3000';

  const toggle        = document.getElementById('sikipon-toggle');
  const win           = document.getElementById('sikipon-window');
  const closeBtn      = document.getElementById('sikipon-close');
  const input         = document.getElementById('sk-input');
  const sendBtn       = document.getElementById('sk-send');
  const messages      = document.getElementById('sk-messages');
  const ghostTyped    = document.getElementById('sk-ghost-typed');
  const ghostSuggestion = document.getElementById('sk-ghost-suggestion');

  let currentSuggestion = '';
  let autocompleteTimer = null;

  // ---- Toggle ----
  toggle.addEventListener('click', () => win.classList.toggle('open'));
  closeBtn.addEventListener('click', () => win.classList.remove('open'));

  // ---- Quick Replies ----
  document.querySelectorAll('.sk-quick-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const question = btn.getAttribute('data-question');
      document.getElementById('sk-quick-replies').classList.add('hidden');
      input.value = question;
      sendMessage();
    });
  });

  // ---- Autocomplétion ----
  input.addEventListener('input', () => {
    const val = input.value;
    ghostTyped.textContent = val;

    clearTimeout(autocompleteTimer);
    currentSuggestion = '';
    ghostSuggestion.textContent = '';

    if (val.length < 3) return;
    autocompleteTimer = setTimeout(() => fetchSuggestion(val), 600);
  });

  async function fetchSuggestion(text) {
    try {
      const res = await fetch(`${FLASK_URL}/api/autocomplete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text })
      });
      const data = await res.json();
      if (data.suggestion && data.suggestion.length > 0) {
        currentSuggestion = data.suggestion;
        ghostSuggestion.textContent = ' ' + data.suggestion;
      }
    } catch (e) {}
  }

  // ---- Tab / Enter / Escape ----
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Tab' && currentSuggestion) {
      e.preventDefault();
      input.value = input.value + ' ' + currentSuggestion;
      ghostTyped.textContent = input.value;
      ghostSuggestion.textContent = '';
      currentSuggestion = '';
    }
    if (e.key === 'Enter') { e.preventDefault(); sendMessage(); }
    if (e.key === 'Escape') { ghostSuggestion.textContent = ''; currentSuggestion = ''; }
  });

  // ---- Envoi ----
  sendBtn.addEventListener('click', sendMessage);

  async function sendMessage() {
    const question = input.value.trim();
    if (!question) return;

    appendMessage('user', question);
    input.value = '';
    ghostTyped.textContent = '';
    ghostSuggestion.textContent = '';
    currentSuggestion = '';
    sendBtn.disabled = true;

    const typingEl = appendTyping();

    try {
      const res = await fetch(`${FLASK_URL}/api/chat-db`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question })
      });
      const data = await res.json();
      typingEl.remove();
      appendMessage('bot', data.answer || data.error || 'Erreur inconnue.');
    } catch (e) {
      typingEl.remove();
      appendMessage('bot', '⚠️ Impossible de contacter Sikipon. Vérifiez le serveur Flask.');
    }

    sendBtn.disabled = false;
    input.focus();
  }

  function appendMessage(who, text) {
    const div = document.createElement('div');
    div.className = `sk-msg ${who}`;
    div.innerHTML = text.replace(/\n/g, '<br>');
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  function appendTyping() {
    const div = document.createElement('div');
    div.className = 'sk-msg typing';
    div.innerHTML = `<div class="typing-dots"><span></span><span></span><span></span></div>`;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

})();
</script>
    {% endblock %}

  </body>
</html>
