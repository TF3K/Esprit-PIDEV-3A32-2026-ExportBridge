<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.ProductsViewController"
      styleClass="page-container">

    <VBox styleClass="page-header">
        <HBox alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS">
                <Text styleClass="page-title" text="Products"/>
                <Text styleClass="page-subtitle" text="Manage your product catalog"/>
            </VBox>
            <HBox spacing="10">
                <Button text="📄 Export PDF" styleClass="secondary-button" onAction="#handleExportPdf"/>
                <Button text="📥 Import PDF" styleClass="secondary-button" onAction="#handleImportPdf"/>
                <Button text="+ Add Product" styleClass="primary-button" onAction="#handleAddProduct"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Statistics Section -->
    <HBox spacing="16" styleClass="product-stats-row">
        <VBox styleClass="product-stat-card stat-total" HBox.hgrow="ALWAYS">
            <Text styleClass="stat-icon" text="📦"/>
            <Text fx:id="statTotalProducts" styleClass="stat-number" text="0"/>
            <Text styleClass="stat-title" text="Total Products"/>
        </VBox>
        <VBox styleClass="product-stat-card stat-categories" HBox.hgrow="ALWAYS">
            <Text styleClass="stat-icon" text="🏷️"/>
            <Text fx:id="statCategories" styleClass="stat-number" text="0"/>
            <Text styleClass="stat-title" text="Categories"/>
        </VBox>
        <VBox styleClass="product-stat-card stat-value" HBox.hgrow="ALWAYS">
            <Text styleClass="stat-icon" text="💰"/>
            <Text fx:id="statTotalValue" styleClass="stat-number" text="0"/>
            <Text styleClass="stat-title" text="Total Value"/>
        </VBox>
        <VBox styleClass="product-stat-card stat-avg" HBox.hgrow="ALWAYS">
            <Text styleClass="stat-icon" text="📊"/>
            <Text fx:id="statAvgPrice" styleClass="stat-number" text="0"/>
            <Text styleClass="stat-title" text="Avg Price"/>
        </VBox>
        <VBox styleClass="product-stat-card stat-stock" HBox.hgrow="ALWAYS">
            <Text styleClass="stat-icon" text="🏭"/>
            <Text fx:id="statTotalStock" styleClass="stat-number" text="0"/>
            <Text styleClass="stat-title" text="Total Stock"/>
        </VBox>
    </HBox>

    <HBox styleClass="search-container" spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   styleClass="search-field"
                   promptText="Search by product name or SKU..."
                   onKeyReleased="#handleSearch"/>

        <ComboBox fx:id="categoryFilter"
                  styleClass="filter-dropdown"
                  promptText="All Categories"
                  onAction="#handleCategoryFilter"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Text fx:id="resultCount" styleClass="result-count" text="0 products"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="products-scroll" VBox.vgrow="ALWAYS">
        <VBox>
            <GridPane fx:id="productsGrid"
                      styleClass="products-grid"
                      hgap="20"
                      vgap="20">
            </GridPane>

            <VBox fx:id="emptyState"
                  styleClass="empty-state"
                  alignment="CENTER"
                  spacing="16"
                  managed="false"
                  visible="false">
                <Text styleClass="empty-state-title" text="No products found"/>
                <Text styleClass="empty-state-subtitle" text="Add your first product to get started"/>
                <Button text="+ Add Product" styleClass="primary-button" onAction="#handleAddProduct"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>