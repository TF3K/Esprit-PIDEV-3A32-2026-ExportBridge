<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.ForgotPasswordDialogController"
      styleClass="dialog-container"
      spacing="20"
      prefWidth="450"
      prefHeight="350"
>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="8">
        <Text text="🔒 Forgot Password" styleClass="dialog-title"/>
        <Text text="Enter your email address and we'll send you a verification code to reset your password."
              styleClass="dialog-subtitle"/>
    </VBox>

    <VBox fx:id="emailStep" spacing="16">
        <VBox spacing="8">
            <Label text="Email Address" styleClass="form-label"/>
            <TextField fx:id="emailField" styleClass="form-field" promptText="your.email@example.com"/>
        </VBox>

        <Label fx:id="emailErrorLabel" styleClass="error-label" managed="false" visible="false" wrapText="true"/>

        <Button text="Send Verification Code" styleClass="primary-button" onAction="#handleSendCode" maxWidth="Infinity"/>
    </VBox>

    <VBox fx:id="resetStep" spacing="16" managed="false" visible="false">
        <VBox spacing="8">
            <Label text="Verification Code" styleClass="form-label"/>
            <TextField fx:id="tokenField" styleClass="form-field" promptText="Enter code from email"/>
        </VBox>

        <VBox spacing="8">
            <Label text="New Password" styleClass="form-label"/>
            <PasswordField fx:id="newPasswordField" styleClass="form-field" promptText="At least 8 characters"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Confirm Password" styleClass="form-label"/>
            <PasswordField fx:id="confirmPasswordField" styleClass="form-field" promptText="Re-enter password"/>
        </VBox>

        <Label fx:id="resetErrorLabel" styleClass="error-label" managed="false" visible="false" wrapText="true"/>

        <Button text="Reset Password" styleClass="primary-button" onAction="#handleResetPassword" maxWidth="Infinity"/>
    </VBox>

    <VBox fx:id="successStep" spacing="16" alignment="CENTER" managed="false" visible="false">
        <Text text="✅" style="-fx-font-size: 48px;"/>
        <Text text="Password Reset Successful!" styleClass="success-title"/>
        <Text text="You can now login with your new password." styleClass="dialog-subtitle"/>
        <Button text="Close" styleClass="primary-button" onAction="#handleClose"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" styleClass="secondary-button" onAction="#handleClose"/>
    </HBox>
</VBox>