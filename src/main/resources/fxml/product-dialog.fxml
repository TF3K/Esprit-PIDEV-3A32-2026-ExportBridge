<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="GUI.ProductDialogController"
      styleClass="dialog-container"
      spacing="20"
      prefWidth="500">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Text fx:id="dialogTitle" styleClass="dialog-title" text="Add Product"/>

    <GridPane hgap="16" vgap="16">
        <Label text="Product Name *" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="form-field" promptText="e.g., Premium Olive Oil"/>

        <Label text="Category *" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
        <ComboBox fx:id="categoryField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="form-field" promptText="Select category" maxWidth="Infinity"/>

        <Label text="HS Code" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="form-label"/>
        <TextField fx:id="hsCodeField" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="form-field" promptText="e.g., 1509.10"/>

        <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="form-label"/>
        <TextArea fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="form-field" promptText="Product description..." prefRowCount="3"/>

        <Label text="Quantity *" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="form-label"/>
        <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <TextField fx:id="quantityField" styleClass="form-field" promptText="1000" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="unitField" styleClass="form-field" promptText="liters" prefWidth="100"/>
        </HBox>

        <Label text="Unit Price *" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="form-label"/>
        <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="5">
            <TextField fx:id="priceField" styleClass="form-field" promptText="25.50" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="currencyField" styleClass="form-field" prefWidth="100"/>
        </HBox>

        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
    </GridPane>

    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="secondary-button" onAction="#handleCancel"/>
        <Button text="Save Product" styleClass="primary-button" onAction="#handleSave"/>
    </HBox>
</VBox>