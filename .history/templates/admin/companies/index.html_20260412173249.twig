{% extends 'admin/base_admin.html.twig' %}

{% block title %}Companies - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Title #}
    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Companies</h1>
            <a href="{{ path('app_admin_companies_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Company
            </a>
        </div>
    </div>

    {# Stats boxes #}
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-primary bg-opacity-10 border border-primary rounded-3">
                <h6>Total Companies</h6>
                <h2 class="mb-0 fs-1 text-primary">{{ companies|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-success bg-opacity-10 border border-success rounded-3">
                <h6>Active</h6>
                <h2 class="mb-0 fs-1 text-success">
                    {{ companies|filter(c => not c.isBanned)|length }}
                </h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-danger bg-opacity-10 border border-danger rounded-3">
                <h6>Banned</h6>
                <h2 class="mb-0 fs-1 text-danger">
                    {{ companies|filter(c => c.isBanned)|length }}
                </h2>
            </div>
        </div>
    </div>

    {# Table #}
    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            {# Search + Filter + Sort toolbar #}
            <div class="row g-3 mb-4">

                {# Search #}
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput"
                            class="form-control bg-light border-0"
                            placeholder="Search...">
                    </div>
                </div>

                {# Filter #}
                <div class="col-6 col-md-3">
                    <select id="filterSelect" class="form-select">
                        <option value="">All Status</option>
                        <option value="yes">Banned</option>
                        <option value="no">Active</option>
                    </select>
                </div>

                {# Sort #}
                <div class="col-6 col-md-2">
                    <select id="sortSelect" class="form-select">
                        <option value="name-asc">Name A→Z</option>
                        <option value="name-desc">Name Z→A</option>
                        <option value="rating-desc">Rating high→low</option>
                        <option value="rating-asc">Rating low→high</option>
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                    </select>
                </div>

                {# Result count #}
                <div class="col-12 col-md-2 d-flex align-items-center">
                    <small class="text-muted" id="resultCount"></small>
                </div>

            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="companiesTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Company Name</th>
                            <th class="border-0">Country</th>
                            <th class="border-0">Domain</th>
                            <th class="border-0">Contact Email</th>
                            <th class="border-0">Rating</th>
                            <th class="border-0">Status</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for company in companies %}
                        <tr data-date="{{ company.createdAt ? company.createdAt|date('U') : 0 }}">
                        <tr>
                            <td><h6 class="mb-0">{{ company.companyName }}</h6></td>
                            <td>{{ company.country ?? '—' }}</td>
                            <td>{{ company.domain ?? '—' }}</td>
                            <td>{{ company.contactEmail ?? '—' }}</td>
                            <td>
                                {% if company.rating %}
                                    <span class="badge text-bg-warning">{{ company.rating }}/5</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>
                                {% if company.isBanned %}
                                    <span class="badge text-bg-danger">Banned</span>
                                {% else %}
                                    <span class="badge text-bg-success">Active</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_admin_companies_edit', {id: company.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form action="{{ path('app_admin_companies_delete', {id: company.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this company?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-company-' ~ company.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr class="empty-row">
                            <td colspan="7" class="text-center text-muted py-4">No companies found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        // ── CONFIG ─────────────────────────────────────────────
        // Table columns: # | Name | Country | Domain | Rating | Banned | Created
        const config = {
            rowSelector:  '#companiesTable tbody tr:not(.empty-row)',
            searchFields: ['td:nth-child(1)', 'td:nth-child(2)', 'td:nth-child(3)', 'td:nth-child(4)'],
            filterField:  'td:nth-child(6)',
            sortFields: {
                'name-asc':    { col: 1, dir: 'asc',  type: 'text' },
                'name-desc':   { col: 1, dir: 'desc', type: 'text' },
                'rating-desc': { col: 5, dir: 'desc', type: 'num'  },
                'rating-asc':  { col: 5, dir: 'asc',  type: 'num'  },
                'newest':      { col: 'date', dir: 'desc', type: 'num' },
                'oldest':      { col: 'date', dir: 'asc',  type: 'num' },
            }
        };
        // ───────────────────────────────────────────────────────

        const rows = () => [...document.querySelectorAll('#companiesTable tbody tr:not(.empty-row)')];
        const searchInput = document.getElementById('searchInput');
        const filterSel   = document.getElementById('filterSelect');
        const sortSel     = document.getElementById('sortSelect');
        const countEl     = document.getElementById('resultCount');

        function normalize(str) {
            return (str || '').toLowerCase().trim();
        }

        function cellText(row, selector) {
            const el = row.querySelector(selector);
            return el ? normalize(el.textContent) : '';
        }

        function apply() {
            const query  = normalize(searchInput.value);
            const filter = normalize(filterSel.value);
            const sort   = sortSel.value;

            // Reset all rows first
            rows().forEach(row => row.style.display = '');

            let visible = rows().filter(row => {
                const matchSearch = !query || config.searchFields.some(sel =>
                    cellText(row, sel).includes(query)
                );
                const matchFilter = !filter ||
                    cellText(row, config.filterField).includes(filter);

                row.style.display = (matchSearch && matchFilter) ? '' : 'none';
                return matchSearch && matchFilter;
            });

            // sort visible rows
            const { col, dir, type } = config.sortFields[sort] || {};
            if (col !== undefined) {
                const tbody = document.querySelector('#companiesTable tbody');
                visible.sort((a, b) => {
                let va, vb;
                if (col === 'date') {
                    va = parseInt(a.dataset.date) || 0;
                    vb = parseInt(b.dataset.date) || 0;
                } else {
                    va = cellText(a, `td:nth-child(${col})`);
                    vb = cellText(b, `td:nth-child(${col})`);
                    if (type === 'num') {
                        va = parseFloat(va.replace('/5', '')) || 0;
                        vb = parseFloat(vb.replace('/5', '')) || 0;
                    }
                }
                if (va < vb) return dir === 'asc' ? -1 : 1;
                if (va > vb) return dir === 'asc' ?  1 : -1;
                return 0;
            }).forEach(row => tbody.appendChild(row));
            }

            countEl.textContent = `${visible.length} result${visible.length !== 1 ? 's' : ''}`;

            console.log('total rows:', rows().length);
            console.log('visible:', visible.length);
        }

        searchInput.addEventListener('input',  apply);
        filterSel.addEventListener('change',   apply);
        sortSel.addEventListener('change',     apply);

        apply(); // run on load to set count
    })();
    </script>
{% endblock %}