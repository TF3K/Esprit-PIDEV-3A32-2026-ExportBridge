{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Edit' : 'Add' }} Company - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {# Title #}
    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">
                {{ mode == 'edit' ? 'Edit Company' : 'Add New Company' }}
            </h1>
            <a href="{{ path('app_admin_companies') }}" class="btn btn-sm btn-secondary mb-0">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header border-bottom">
            <h5 class="card-header-title">Company Information</h5>
        </div>
        <div class="card-body">
            <form action="" method="post" class="row g-4">

                {# Company Name #}
                <div class="col-lg-6">
                    <label class="form-label">Company Name *</label>
                    <input type="text" name="company_name" class="form-control"
                           value="{{ company.companyName ?? '' }}" required>
                </div>

                {# Domain #}
                <div class="col-lg-6">
                    <label class="form-label">Domain</label>
                    <input type="text" name="domain" class="form-control"
                           placeholder="e.g. manufacturing"
                           value="{{ company.domain ?? '' }}">
                </div>

                {# Tax Number #}
                <div class="col-lg-6">
                    <label class="form-label">Tax Number</label>
                    <input type="text" name="tax_number" class="form-control"
                           value="{{ company.taxNumber ?? '' }}">
                </div>

                {# Registration Number #}
                <div class="col-lg-6">
                    <label class="form-label">Registration Number</label>
                    <input type="text" name="registration_number" class="form-control"
                           value="{{ company.registrationNumber ?? '' }}">
                </div>

                {# Country #}
                <div class="col-lg-6">
                    <label class="form-label">Country</label>
                    <input type="text" name="country" class="form-control"
                           value="{{ company.country ?? '' }}">
                </div>

                {# Contact Email #}
                <div class="col-lg-6">
                    <label class="form-label">Contact Email</label>
                    <input type="email" name="contact_email" class="form-control"
                           value="{{ company.contactEmail ?? '' }}">
                </div>

                {# Contact Phone #}
                <div class="col-lg-6">
                    <label class="form-label">Contact Phone</label>
                    <input type="text" name="contact_phone" class="form-control"
                           value="{{ company.contactPhone ?? '' }}">
                </div>

                {# Rating #}
                <div class="col-lg-6">
                    <label class="form-label">Rating (1-5)</label>
                    <input type="number" name="rating" class="form-control"
                           min="1" max="5"
                           value="{{ company.rating ?? '' }}">
                </div>

                {# Address #}
                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea name="address" class="form-control" rows="3">{{ company.address ?? '' }}</textarea>
                </div>

                {# Banned toggle — only show in edit mode #}
                {% if mode == 'edit' %}
                <div class="col-12">
                    <div class="form-check form-switch form-check-lg">
                        <input class="form-check-input" type="checkbox"
                               name="is_banned" id="isBanned"
                               {{ company.isBanned ? 'checked' : '' }}>
                        <label class="form-check-label" for="isBanned">Banned</label>
                    </div>
                </div>
                {% endif %}

                {# Submit #}
                <div class="d-sm-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-0">
                        {{ mode == 'edit' ? 'Save Changes' : 'Add Company' }}
                    </button>
                </div>

            </form>
        </div>
    </div>

{% endblock %}