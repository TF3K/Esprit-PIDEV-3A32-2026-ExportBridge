{% extends 'admin/base_admin.html.twig' %}

{% block title %}Products - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Products</h1>
            <a href="{{ path('app_admin_products_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            <div class="row g-3 mb-4">

                {# Search #}
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput"
                            class="form-control"
                            placeholder="Search...">
                    </div>
                </div>

                {# Filter #}
                <div class="col-6 col-md-3">
                    <select id="filterSelect" class="form-select">
                        <option value="">All Currencies</option>
                        <option value="EUR">EUR</option>
                        <option value="USD">USD</option>
                        <option value="TND">TND</option>
                        <option value="GBP">GBP</option>
                    </select>
                </div>

                {# Sort #}
                <div class="col-6 col-md-2">
                    <select id="sortSelect" class="form-select">
                        <option value="name-asc">Name A→Z</option>
                        <option value="name-desc">Name Z→A</option>
                        <option value="price-desc">Price high→low</option>
                        <option value="price-asc">Price low→high</option>
                    </select>
                </div>

                {# Result count #}
                <div class="col-12 col-md-2 d-flex align-items-center">
                    <small class="text-muted" id="resultCount"></small>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="productsTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Product Name</th>
                            <th class="border-0">Company</th>
                            <th class="border-0">Category</th>
                            <th class="border-0">HS Code</th>
                            <th class="border-0">Unit Price</th>
                            <th class="border-0">Currency</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                        <tr>
                            <td><h6 class="mb-0">{{ product.name }}</h6></td>
                            <td>{{ product.company ? product.company.companyName : '—' }}</td>
                            <td>
                                {% if product.productCategory %}
                                    <span class="badge text-bg-info">
                                        {{ product.productCategory.name }}
                                    </span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td><code>{{ product.hsCode ?? '—' }}</code></td>
                            <td>{{ product.unitPrice ?? '—' }}</td>
                            <td>{{ product.currency ?? '—' }}</td>
                            <td>
                                <a href="{{ path('app_admin_products_edit', {id: product.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form action="{{ path('app_admin_products_delete', {id: product.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this product?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete-product-' ~ product.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No products found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        // ── CONFIG ─────────────────────────────────────────────
        // Table columns: # | Name | Category | Company | Currency | HS Code | Created
        const config = {
            rowSelector:  '#productsTable tbody tr',
            searchFields: ['td:nth-child(2)', 'td:nth-child(4)'],
            filterField:  'td:nth-child(6)',
            sortFields: {
                'name-asc':    { col: 1, dir: 'asc',  type: 'text' },
                'name-desc':   { col: 1, dir: 'desc', type: 'text' },
                'price-desc':  { col: 4, dir: 'desc', type: 'num'  },
                'price-asc':   { col: 4, dir: 'asc',  type: 'num'  },
            }
        };
        // ───────────────────────────────────────────────────────

        const rows        = () => [...document.querySelectorAll(config.rowSelector)];
        const searchInput = document.getElementById('searchInput');
        const filterSel   = document.getElementById('filterSelect');
        const sortSel     = document.getElementById('sortSelect');
        const countEl     = document.getElementById('resultCount');

        function normalize(str) {
            return (str || '').toLowerCase().trim();
        }

        function cellText(row, selector) {
            const el = row.querySelector(selector);
            return el ? normalize(el.textContent) : '';
        }

        function apply() {
            const query  = normalize(searchInput.value);
            const filter = normalize(filterSel.value);
            const sort   = sortSel.value;

            let visible = rows().filter(row => {
                // search across configured fields
                const matchSearch = !query || config.searchFields.some(sel =>
                    cellText(row, sel).includes(query)
                );
                // filter on one column
                const matchFilter = !filter ||
                    cellText(row, config.filterField).includes(filter);

                row.style.display = (matchSearch && matchFilter) ? '' : 'none';
                return matchSearch && matchFilter;
            });

            // sort visible rows
            const { col, dir, type } = config.sortFields[sort] || {};
            if (col !== undefined) {
                const tbody = document.querySelector('#productsTable tbody');
                visible.sort((a, b) => {
                    let va = cellText(a, `td:nth-child(${col + 1})`);
                    let vb = cellText(b, `td:nth-child(${col + 1})`);
                    if (type === 'num') { va = parseFloat(va) || 0; vb = parseFloat(vb) || 0; }
                    if (va < vb) return dir === 'asc' ? -1 : 1;
                    if (va > vb) return dir === 'asc' ?  1 : -1;
                    return 0;
                }).forEach(row => tbody.appendChild(row));
            }

            countEl.textContent = `${visible.length} result${visible.length !== 1 ? 's' : ''}`;
        }

        searchInput.addEventListener('input',  apply);
        filterSel.addEventListener('change',   apply);
        sortSel.addEventListener('change',     apply);

        apply(); // run on load to set count
    })();
    </script>
{% endblock %}