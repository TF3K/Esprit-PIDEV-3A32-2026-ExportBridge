{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ mode == 'edit' ? 'Edit' : 'Add' }} Product - ExportBridge Admin{% endblock %}

{% block admin_content %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">
                {{ mode == 'edit' ? 'Edit Product' : 'Add New Product' }}
            </h1>
            <a href="{{ path('app_admin_products') }}" class="btn btn-sm btn-secondary mb-0">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header border-bottom">
            <h5 class="card-header-title">Product Information</h5>
        </div>
        <div class="card-body">
            <form action="" method="post" class="row g-4">

                {# Name #}
                <div class="col-lg-6">
                    <label class="form-label">Product Name *</label>
                    <input type="text" name="name"
                           class="form-control {{ errors.name is defined ? 'is-invalid' : '' }}"
                           value="{{ old.name ?? product.name ?? '' }}" required>
                    {% if errors.name is defined %}
                        <div class="invalid-feedback">{{ errors.name }}</div>
                    {% endif %}
                </div>

                {# HS Code #}
                <div class="col-lg-6">
                    <label class="form-label">HS Code</label>
                    <input type="text" name="hs_code"
                           class="form-control {{ errors.hs_code is defined ? 'is-invalid' : '' }}"
                           placeholder="e.g. 6109.10"
                           value="{{ old.hsCode ?? product.hsCode ?? '' }}">
                    {% if errors.hs_code is defined %}
                        <div class="invalid-feedback">{{ errors.hs_code }}</div>
                    {% else %}
                        <div class="form-text">Harmonized System code for EU export</div>
                    {% endif %}
                </div>

                {# Company #}
                <div class="col-lg-6">
                    <label class="form-label">Company *</label>
                    <select name="company_id"
                            class="form-select {{ errors.company_id is defined ? 'is-invalid' : '' }}" required>
                        <option value="">— Select Company —</option>
                        {% for company in companies %}
                            <option value="{{ company.id }}"
                                {{ (old.companyId ?? product.company.id ?? '') == company.id ? 'selected' : '' }}>
                                {{ company.companyName }}
                            </option>
                        {% endfor %}
                    </select>
                    {% if errors.company_id is defined %}
                        <div class="invalid-feedback">{{ errors.company_id }}</div>
                    {% endif %}
                </div>

                {# Category #}
                <div class="col-lg-6">
                    <label class="form-label">Category</label>
                    <select name="category_id" class="form-select">
                        <option value="">— No Category —</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}"
                                {{ (old.categoryId ?? product.productCategory.id ?? '') == category.id ? 'selected' : '' }}>
                                {{ category.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Quantity #}
                <div class="col-lg-4">
                    <label class="form-label">Quantity</label>
                    <input type="number" step="0.01" name="quantity"
                           class="form-control {{ errors.quantity is defined ? 'is-invalid' : '' }}"
                           value="{{ old.quantity ?? product.quantity ?? '' }}">
                    {% if errors.quantity is defined %}
                        <div class="invalid-feedback">{{ errors.quantity }}</div>
                    {% endif %}
                </div>

                {# Unit #}
                <div class="col-lg-4">
                    <label class="form-label">Unit</label>
                    <select name="unit" class="form-select">
                        <option value="">— Select Unit —</option>
                        {% for unit in ['kg', 'g', 'ton', 'L', 'mL', 'pcs', 'm', 'm²', 'm³'] %}
                            <option value="{{ unit }}"
                                {{ (old.unit ?? product.unit ?? '') == unit ? 'selected' : '' }}>
                                {{ unit }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Unit Price #}
                <div class="col-lg-4">
                    <label class="form-label">Unit Price</label>
                    <input type="number" step="0.01" name="unit_price"
                           class="form-control {{ errors.unit_price is defined ? 'is-invalid' : '' }}"
                           value="{{ old.unitPrice ?? product.unitPrice ?? '' }}">
                    {% if errors.unit_price is defined %}
                        <div class="invalid-feedback">{{ errors.unit_price }}</div>
                    {% endif %}
                </div>

                {# Currency #}
                <div class="col-lg-6">
                    <label class="form-label">Currency *</label>
                    <select name="currency"
                            class="form-select {{ errors.currency is defined ? 'is-invalid' : '' }}">
                        <option value="">— Select Currency —</option>
                        {% for currency in ['EUR', 'USD', 'TND', 'GBP'] %}
                            <option value="{{ currency }}"
                                {{ (old.currency ?? product.currency ?? '') == currency ? 'selected' : '' }}>
                                {{ currency }}
                            </option>
                        {% endfor %}
                    </select>
                    {% if errors.currency is defined %}
                        <div class="invalid-feedback">{{ errors.currency }}</div>
                    {% endif %}
                </div>

                {# Origin Criteria #}
                <div class="col-lg-6">
                    <label class="form-label">Origin Criteria</label>
                    <input type="text" name="origin_criteria"
                           class="form-control {{ errors.origin_criteria is defined ? 'is-invalid' : '' }}"
                           placeholder="e.g. Wholly obtained"
                           value="{{ old.originCriteria ?? product.originCriteria ?? '' }}">
                    {% if errors.origin_criteria is defined %}
                        <div class="invalid-feedback">{{ errors.origin_criteria }}</div>
                    {% endif %}
                </div>

                {# Description #}
                <div class="col-12">
                    <label class="form-label">Description *</label>
                    <textarea name="description" rows="3"
                              class="form-control {{ errors.description is defined ? 'is-invalid' : '' }}">{{ old.description ?? product.description ?? '' }}</textarea>
                    {% if errors.description is defined %}
                        <div class="invalid-feedback">{{ errors.description }}</div>
                    {% endif %}
                </div>

                <div class="d-sm-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-0">
                        {{ mode == 'edit' ? 'Save Changes' : 'Add Product' }}
                    </button>
                </div>

            </form>
        </div>
    </div>

{% endblock %}