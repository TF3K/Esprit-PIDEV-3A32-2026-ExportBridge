{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Edit' : 'Add' }} Product - ExportBridge Admin{% endblock %}

{% block admin_content %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">
                {{ mode == 'edit' ? 'Edit Product' : 'Add New Product' }}
            </h1>
            <a href="{{ path('app_admin_products') }}" class="btn btn-sm btn-secondary mb-0">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header border-bottom">
            <h5 class="card-header-title">Product Information</h5>
        </div>
        <div class="card-body">
            <form action="" method="post" class="row g-4">

                {# Name #}
                <div class="col-lg-6">
                    <label class="form-label">Product Name *</label>
                    <input type="text" name="name" class="form-control"
                           value="{{ product.name ?? '' }}" required>
                </div>

                {# HS Code #}
                <div class="col-lg-6">
                    <label class="form-label">HS Code</label>
                    <input type="text" name="hs_code" class="form-control"
                           placeholder="e.g. 6109.10"
                           value="{{ product.hsCode ?? '' }}">
                    <div class="form-text">Harmonized System code for EU export</div>
                </div>

                {# Company #}
                <div class="col-lg-6">
                    <label class="form-label">Company *</label>
                    <select name="company_id" class="form-select" required>
                        <option value="">— Select Company —</option>
                        {% for company in companies %}
                            <option value="{{ company.id }}"
                                {{ product.companie and product.companie.id == company.id ? 'selected' : '' }}>
                                {{ company.companyName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Category #}
                <div class="col-lg-6">
                    <label class="form-label">Category</label>
                    <select name="category_id" class="form-select">
                        <option value="">— No Category —</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}"
                                {{ product.productCategori and product.productCategorie.id == category.id ? 'selected' : '' }}>
                                {{ category.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Quantity #}
                <div class="col-lg-4">
                    <label class="form-label">Quantity</label>
                    <input type="number" step="0.01" name="quantity" class="form-control"
                           value="{{ product.quantity ?? '' }}">
                </div>

                {# Unit #}
                <div class="col-lg-4">
                    <label class="form-label">Unit</label>
                    <select name="unit" class="form-select">
                        <option value="">— Select Unit —</option>
                        {% for unit in ['kg', 'g', 'ton', 'L', 'mL', 'pcs', 'm', 'm²', 'm³'] %}
                            <option value="{{ unit }}"
                                {{ product.unit == unit ? 'selected' : '' }}>
                                {{ unit }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Unit Price #}
                <div class="col-lg-4">
                    <label class="form-label">Unit Price</label>
                    <input type="number" step="0.01" name="unit_price" class="form-control"
                           value="{{ product.unitPrice ?? '' }}">
                </div>

                {# Currency #}
                <div class="col-lg-6">
                    <label class="form-label">Currency</label>
                    <select name="currency" class="form-select">
                        <option value="">— Select Currency —</option>
                        {% for currency in ['EUR', 'USD', 'TND', 'GBP'] %}
                            <option value="{{ currency }}"
                                {{ product.currency == currency ? 'selected' : '' }}>
                                {{ currency }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Origin Criteria #}
                <div class="col-lg-6">
                    <label class="form-label">Origin Criteria</label>
                    <input type="text" name="origin_criteria" class="form-control"
                           placeholder="e.g. Wholly obtained"
                           value="{{ product.originCriteria ?? '' }}">
                </div>

                {# Description #}
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control"
                              rows="3">{{ product.description ?? '' }}</textarea>
                </div>

                <div class="d-sm-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-0">
                        {{ mode == 'edit' ? 'Save Changes' : 'Add Product' }}
                    </button>
                </div>

            </form>
        </div>
    </div>

{% endblock %}