{% extends 'admin/base_admin.html.twig' %}

{% block title %}Product Categories - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Product Categories</h1>
            <a href="{{ path('app_admin_product_categories_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Category
            </a>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            <div class="row g-3 mb-4">

                {# Search #}
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput"
                            class="form-control"
                            placeholder="Search...">
                    </div>
                </div>

                {# Filter #}
                <div class="col-6 col-md-3">
                    <select id="filterSelect" class="form-select">
                        <option value="">All Categories</option>
                    </select>
                </div>

                {# Sort #}
                <div class="col-6 col-md-2">
                    <select id="sortSelect" class="form-select">
                        <option value="number-asc">Number A→Z</option>
                        <option value="type-asc">Type A→Z</option>
                        <option value="expiry-asc">Expiry earliest</option>
                        <option value="expiry-desc">Expiry latest</option>
                    </select>
                </div>

                {# Result count #}
                <div class="col-12 col-md-2 d-flex align-items-center">
                    <small class="text-muted" id="resultCount"></small>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="categoriesTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Name</th>
                            <th class="border-0">Slug</th>
                            <th class="border-0">Description</th>
                            <th class="border-0">Products</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                        <tr>
                            <td><h6 class="mb-0">{{ category.name }}</h6></td>
                            <td><code>{{ category.slug }}</code></td>
                            <td>{{ category.description }}</td>
                            <td>
                                <span class="badge text-bg-primary">
                                    {{ category.products|length }} products
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_admin_product_categories_edit', {id: category.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form action="{{ path('app_admin_product_categories_delete', {id: category.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category? Products in it will lose their category.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-category-' ~ category.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No categories found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        // ── CONFIG ─────────────────────────────────────────────
// Table columns: # | Name | Slug | Description
const config = {
    rowSelector:  'tbody tr',
    searchFields: ['td:nth-child(2)', 'td:nth-child(3)'],
    filterField:  'td:nth-child(2)',  // no meaningful filter, so filter == search col
    sortFields: {
        'name-asc':  { col: 1, dir: 'asc',  type: 'text' },
        'name-desc': { col: 1, dir: 'desc', type: 'text' },
        'slug-asc':  { col: 2, dir: 'asc',  type: 'text' },
    }
};
        // ───────────────────────────────────────────────────────

        const rows        = () => [...document.querySelectorAll(config.rowSelector)];
        const searchInput = document.getElementById('searchInput');
        const filterSel   = document.getElementById('filterSelect');
        const sortSel     = document.getElementById('sortSelect');
        const countEl     = document.getElementById('resultCount');

        function normalize(str) {
            return (str || '').toLowerCase().trim();
        }

        function cellText(row, selector) {
            const el = row.querySelector(selector);
            return el ? normalize(el.textContent) : '';
        }

        function apply() {
            const query  = normalize(searchInput.value);
            const filter = normalize(filterSel.value);
            const sort   = sortSel.value;

            let visible = rows().filter(row => {
                // search across configured fields
                const matchSearch = !query || config.searchFields.some(sel =>
                    cellText(row, sel).includes(query)
                );
                // filter on one column
                const matchFilter = !filter ||
                    cellText(row, config.filterField).includes(filter);

                row.style.display = (matchSearch && matchFilter) ? '' : 'none';
                return matchSearch && matchFilter;
            });

            // sort visible rows
            const { col, dir, type } = config.sortFields[sort] || {};
            if (col !== undefined) {
                const tbody = document.querySelector('#certsTable tbody');
                visible.sort((a, b) => {
                    let va = cellText(a, `td:nth-child(${col + 1})`);
                    let vb = cellText(b, `td:nth-child(${col + 1})`);
                    if (type === 'num') { va = parseFloat(va) || 0; vb = parseFloat(vb) || 0; }
                    if (va < vb) return dir === 'asc' ? -1 : 1;
                    if (va > vb) return dir === 'asc' ?  1 : -1;
                    return 0;
                }).forEach(row => tbody.appendChild(row));
            }

            countEl.textContent = `${visible.length} result${visible.length !== 1 ? 's' : ''}`;
        }

        searchInput.addEventListener('input',  apply);
        filterSel.addEventListener('change',   apply);
        sortSel.addEventListener('change',     apply);

        apply(); // run on load to set count
    })();
    </script>
{% endblock %}