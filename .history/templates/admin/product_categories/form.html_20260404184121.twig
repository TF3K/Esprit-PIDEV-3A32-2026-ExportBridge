{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Edit' : 'Add' }} Category - ExportBridge Admin{% endblock %}

{% block admin_content %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">
                {{ mode == 'edit' ? 'Edit Category' : 'Add New Category' }}
            </h1>
            <a href="{{ path('app_admin_product_categories') }}" class="btn btn-sm btn-secondary mb-0">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header border-bottom">
            <h5 class="card-header-title">Category Information</h5>
        </div>
        <div class="card-body">
            <form action="" method="post" class="row g-4">

                <div class="col-lg-6">
                    <label class="form-label">Name *</label>
                    <input type="text" name="name" class="form-control"
                           value="{{ category.name ?? '' }}" required>
                </div>

                <div class="col-lg-6">
                    <label class="form-label">Slug *</label>
                    <input type="text" name="slug" class="form-control" id="slugInput"
                           value="{{ category.slug ?? '' }}" required>
                    <div class="form-text">URL-friendly identifier, e.g. "textile-goods"</div>
                </div>

                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="3">{{ category.description ?? '' }}</textarea>
                </div>

                <div class="d-sm-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mb-0">
                        {{ mode == 'edit' ? 'Save Changes' : 'Add Category' }}
                    </button>
                </div>

            </form>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        {# Auto-generate slug from name #}
        {% if mode == 'add' %}
        document.querySelector('[name="name"]').addEventListener('input', function() {
            document.getElementById('slugInput').value = this.value
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-');
        });
        {% endif %}
    </script>
{% endblock %}