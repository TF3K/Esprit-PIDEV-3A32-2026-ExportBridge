{% extends 'admin/base_admin.html.twig' %}

{% block title %}Markets - ExportBridge Admin{% endblock %}

{% block admin_content %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="row mb-3">
        <div class="col-12 d-sm-flex justify-content-between align-items-center">
            <h1 class="h3 mb-2 mb-sm-0">Markets</h1>
            <a href="{{ path('app_admin_markets_add') }}" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add Market
            </a>
        </div>
    </div>

    {# Stats #}
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-primary bg-opacity-10 border border-primary rounded-3">
                <h6>Total Markets</h6>
                <h2 class="mb-0 fs-1 text-primary">{{ markets|length }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-success bg-opacity-10 border border-success rounded-3">
                <h6>EU Markets</h6>
                <h2 class="mb-0 fs-1 text-success">
                    {{ markets|filter(m => m.isEu)|length }}
                </h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="text-center p-4 bg-info bg-opacity-10 border border-info rounded-3">
                <h6>Non-EU Markets</h6>
                <h2 class="mb-0 fs-1 text-info">
                    {{ markets|filter(m => not m.isEu)|length }}
                </h2>
            </div>
        </div>
    </div>

    <div class="card bg-transparent border">
        <div class="card-header bg-light border-bottom">
            <div class="row g-3 mb-4">

                {# Search #}
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput"
                            class="form-control"
                            placeholder="Search...">
                    </div>
                </div>

                {# Filter #}
                <div class="col-6 col-md-3">
                    <select id="filterSelect" class="form-select">
                        <option value="">All Markets</option>
                        <option value="yes">EU Market</option>
                        <option value="no">Non-EU</option>
                    </select>
                </div>

                {# Sort #}
                <div class="col-6 col-md-2">
                    <select id="sortSelect" class="form-select">
                        <option value="name-asc">Name A→Z</option>
                        <option value="name-desc">Name Z→A</option>
                        <option value="code-asc">Code A→Z</option>
                        <option value="region-asc">Region A→Z</option>
                    </select>
                </div>

                {# Result count #}
                <div class="col-12 col-md-2 d-flex align-items-center">
                    <small class="text-muted" id="resultCount"></small>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive border-0 rounded-3">
                <table class="table table-dark-gray align-middle p-4 mb-0 table-hover" id="marketsTable">
                    <thead>
                        <tr>
                            <th class="border-0 rounded-start">Country</th>
                            <th class="border-0">Code</th>
                            <th class="border-0">Region</th>
                            <th class="border-0">Trade Agreement</th>
                            <th class="border-0">EU</th>
                            <th class="border-0">Requirements</th>
                            <th class="border-0 rounded-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for market in markets %}
                        <tr>
                            <td><h6 class="mb-0">{{ market.name }}</h6></td>
                            <td><code>{{ market.countryCode }}</code></td>
                            <td>{{ market.region ?? '—' }}</td>
                            <td>{{ market.tradeAgreement ?? '—' }}</td>
                            <td>
                                {% if market.isEu %}
                                    <span class="badge text-bg-success">EU</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Non-EU</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge text-bg-primary">
                                    {{ market.certificateRequirements|length }} requirements
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_admin_markets_edit', {id: market.id}) }}"
                                   class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form action="{{ path('app_admin_markets_delete', {id: market.id}) }}"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this market?')">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete-market-' ~ market.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No markets found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        // ── CONFIG ─────────────────────────────────────────────
        // Table columns: # | Name | Code | Region | Trade Agreement | EU | Created
        const config = {
            rowSelector:  '#marketsTable tbody tr',
            searchFields: ['td:nth-child(1)', 'td:nth-child(2)', 'td:nth-child(3)'],
            filterField:  'td:nth-child(6)',
            sortFields: {
                'name-asc':  { col: 1, dir: 'asc',  type: 'text' },
                'name-desc': { col: 1, dir: 'desc', type: 'text' },
                'code-asc':  { col: 2, dir: 'asc',  type: 'text' },
                'region-asc':{ col: 3, dir: 'asc',  type: 'text' },
            }
        };
        // ───────────────────────────────────────────────────────

        const rows        = () => [...document.querySelectorAll(config.rowSelector)];
        const searchInput = document.getElementById('searchInput');
        const filterSel   = document.getElementById('filterSelect');
        const sortSel     = document.getElementById('sortSelect');
        const countEl     = document.getElementById('resultCount');

        function normalize(str) {
            return (str || '').toLowerCase().trim();
        }

        function cellText(row, selector) {
            const el = row.querySelector(selector);
            return el ? normalize(el.textContent) : '';
        }

        function apply() {
            const query  = normalize(searchInput.value);
            const filter = normalize(filterSel.value);
            const sort   = sortSel.value;

            let visible = rows().filter(row => {
                // search across configured fields
                const matchSearch = !query || config.searchFields.some(sel =>
                    cellText(row, sel).includes(query)
                );
                // filter on one column
                const matchFilter = !filter ||
                    cellText(row, config.filterField).includes(filter);

                row.style.display = (matchSearch && matchFilter) ? '' : 'none';
                return matchSearch && matchFilter;
            });

            // sort visible rows
            const { col, dir, type } = config.sortFields[sort] || {};
            if (col !== undefined) {
                const tbody = document.querySelector('#marketsTable tbody');
                visible.sort((a, b) => {
                    let va = cellText(a, `td:nth-child(${col + 1})`);
                    let vb = cellText(b, `td:nth-child(${col + 1})`);
                    if (type === 'num') { va = parseFloat(va) || 0; vb = parseFloat(vb) || 0; }
                    if (va < vb) return dir === 'asc' ? -1 : 1;
                    if (va > vb) return dir === 'asc' ?  1 : -1;
                    return 0;
                }).forEach(row => tbody.appendChild(row));
            }

            countEl.textContent = `${visible.length} result${visible.length !== 1 ? 's' : ''}`;
        }

        searchInput.addEventListener('input',  apply);
        filterSel.addEventListener('change',   apply);
        sortSel.addEventListener('change',     apply);

        apply(); // run on load to set count
    })();
    </script>
{% endblock %}